/* Classic: a sample third-party theme in the spirit of the Unity 2017 editor.
   Choose it in Poi/Thry/Settings → Theme → Inspector Theme. Copy this file outside the
   Poiyomi folder and rename it to make your own theme; see Editor/UI_STYLING.md.

   Gradients use the --thry-gradient-top and --thry-gradient-bottom hooks. A gradient
   covers its surface's fill, and the base theme colors a button's border with that same
   fill token, so the button fill tokens below set the outline. Gray sliders other than
   zero replace this theme's surface colors. */

/* Both skins: square section bars like the old component headers. */
.thry-inspector, .thry-dropdown-menu {
    --thry-radius-header: 0px;
    --thry-radius-subheader: 0px;
    --thry-radius-panel: 0px;
    --thry-radius-control: 3px;
}

/* ===== Light skin (Personal) ===== */
.thry-inspector.thry-light, .thry-dropdown-menu.thry-light {
    --thry-background-color: #c2c2c2;
    --thry-chrome-background: #c2c2c2;
    --thry-panel-background: #cbcbcb;
    --thry-surface-color: #d8d8d8;
    --thry-hover-color: #e2e2e2;
    --thry-border-color: #999999;
    --thry-control-border-color: #9a9a9a;
    --thry-input-background: #f0f0f0;
    --thry-field-background: #f6f6f6;
    --thry-dropdown-background: #e2e2e2;
    --thry-dropdown-hover-background: #ebebeb;
    --thry-accent-color: #3e7de7;
    --thry-focus-color: #5b8fe0;
    --thry-selection-background: #a8c4ee;
    --thry-button-selected-hover-background: #b8cff1;
    --thry-caption-color: #000000;
    --thry-value-color: #000000;
    --thry-muted-color: #5a5a5a;
    --thry-root-section-text-color: #000000;
    --thry-action-text-color: #000000;
    --thry-section-background: #d0d0d0;
    --thry-root-section-background: #d0d0d0;
    --thry-root-section-hover-background: #d8d8d8;
    --thry-subsection-background: #c9c9c9;
    --thry-subsection-hover-background: #d1d1d1;
    --thry-track-color: #8f8f8f;
    --thry-thumb-color: #e8e8e8;
    --thry-range-fill-start: #8c8c8c;
    --thry-range-fill-end: #8c8c8c;
    /* Button fills are covered by the gradient and show as the outline. */
    --thry-action-background: #9a9a9a;
    --thry-action-hover-background: #8c8c8c;
    --thry-button-pressed-background: #7a7a7a;
    --thry-button-disabled-background: #b4b4b4;
    --thry-disabled-background: #cfcfcf;
    --thry-disabled-border: #b0b0b0;
    --thry-toggle-on-background: #8a8a8a;
    --thry-toggle-on-hover-background: #808080;
    --thry-toggle-on-pressed-background: #737373;
    --thry-toggle-on-disabled-background: #aaaaaa;
    --thry-toggle-on-border-color: #6e6e6e;
    --thry-toggle-on-disabled-border-color: #9a9a9a;
    --thry-toggle-on-text-color: #000000;
    --thry-toggle-on-disabled-text-color: #5a5a5a;
}

.thry-inspector.thry-light Button {
    --thry-gradient-top: #f6f6f6;
    --thry-gradient-bottom: #d4d4d4;
}

.thry-inspector.thry-light Button:hover {
    --thry-gradient-top: #fbfbfb;
    --thry-gradient-bottom: #dcdcdc;
}

.thry-inspector.thry-light Button:disabled {
    --thry-gradient-top: #e8e8e8;
    --thry-gradient-bottom: #dadada;
}

.thry-inspector.thry-light Button.thry-selected,
.thry-inspector.thry-light Button:enabled:active {
    --thry-gradient-top: #b4b4b4;
    --thry-gradient-bottom: #cacaca;
}

.thry-inspector.thry-light Button.thry-selected:hover {
    --thry-gradient-top: #bcbcbc;
    --thry-gradient-bottom: #d2d2d2;
}

.thry-inspector.thry-light .unity-base-popup-field__input {
    --thry-gradient-top: #f6f6f6;
    --thry-gradient-bottom: #d4d4d4;
}

.thry-inspector.thry-light .unity-disabled .unity-base-popup-field__input {
    --thry-gradient-top: #e8e8e8;
    --thry-gradient-bottom: #dadada;
}

.thry-inspector.thry-light .unity-base-popup-field > .unity-base-popup-field__input {
    border-color: #999999;
}

/* A slightly darker top edge reads as the old inset text field. */
.thry-inspector.thry-light .unity-base-text-field__input {
    --thry-gradient-top: #e9e9e9;
    --thry-gradient-bottom: #fafafa;
}

.thry-inspector.thry-light .thry-section-header {
    --thry-gradient-top: #dedede;
    --thry-gradient-bottom: #c6c6c6;
}

.thry-inspector.thry-light .thry-section-header:hover {
    --thry-gradient-top: #e6e6e6;
    --thry-gradient-bottom: #cecece;
}

.thry-inspector.thry-light .thry-subsection-panel > .thry-section-header {
    --thry-gradient-top: #d6d6d6;
    --thry-gradient-bottom: #c2c2c2;
}

.thry-inspector.thry-light .thry-root-section > .thry-section-header {
    border-top-width: 1px;
    border-top-color: #a0a0a0;
}

/* ===== Dark skin (Pro) ===== */
.thry-inspector.thry-dark, .thry-dropdown-menu.thry-dark {
    --thry-background-color: #383838;
    --thry-chrome-background: #383838;
    --thry-panel-background: #3d3d3d;
    --thry-surface-color: #474747;
    --thry-hover-color: #505050;
    --thry-border-color: #232323;
    --thry-control-border-color: #212121;
    --thry-input-background: #2b2b2b;
    --thry-field-background: #2f2f2f;
    --thry-dropdown-background: #4c4c4c;
    --thry-dropdown-hover-background: #575757;
    --thry-accent-color: #4d78cc;
    --thry-focus-color: #4f7bd0;
    --thry-selection-background: #3e5f96;
    --thry-button-selected-hover-background: #46699f;
    --thry-caption-color: #b4b4b4;
    --thry-value-color: #c2c2c2;
    --thry-muted-color: #7d7d7d;
    --thry-root-section-text-color: #c8c8c8;
    --thry-action-text-color: #c8c8c8;
    --thry-section-background: #464646;
    --thry-root-section-background: #464646;
    --thry-root-section-hover-background: #4e4e4e;
    --thry-subsection-background: #424242;
    --thry-subsection-hover-background: #4a4a4a;
    --thry-track-color: #2a2a2a;
    --thry-thumb-color: #8a8a8a;
    --thry-range-fill-start: #5a5a5a;
    --thry-range-fill-end: #5a5a5a;
    /* Button fills are covered by the gradient and show as the outline. */
    --thry-action-background: #222222;
    --thry-action-hover-background: #2a2a2a;
    --thry-button-pressed-background: #1a1a1a;
    --thry-button-disabled-background: #2e2e2e;
    --thry-disabled-background: #333333;
    --thry-disabled-border: #2a2a2a;
    --thry-toggle-on-background: #1e1e1e;
    --thry-toggle-on-hover-background: #262626;
    --thry-toggle-on-pressed-background: #181818;
    --thry-toggle-on-disabled-background: #2c2c2c;
    --thry-toggle-on-border-color: #151515;
    --thry-toggle-on-disabled-border-color: #2a2a2a;
    --thry-toggle-on-text-color: #e0e0e0;
    --thry-toggle-on-disabled-text-color: #7d7d7d;
}

.thry-inspector.thry-dark Button {
    --thry-gradient-top: #5c5c5c;
    --thry-gradient-bottom: #474747;
}

.thry-inspector.thry-dark Button:hover {
    --thry-gradient-top: #636363;
    --thry-gradient-bottom: #4d4d4d;
}

.thry-inspector.thry-dark Button:disabled {
    --thry-gradient-top: #4a4a4a;
    --thry-gradient-bottom: #424242;
}

.thry-inspector.thry-dark Button.thry-selected,
.thry-inspector.thry-dark Button:enabled:active {
    --thry-gradient-top: #353535;
    --thry-gradient-bottom: #404040;
}

.thry-inspector.thry-dark Button.thry-selected:hover {
    --thry-gradient-top: #3a3a3a;
    --thry-gradient-bottom: #464646;
}

.thry-inspector.thry-dark .unity-base-popup-field__input {
    --thry-gradient-top: #5c5c5c;
    --thry-gradient-bottom: #474747;
}

.thry-inspector.thry-dark .unity-disabled .unity-base-popup-field__input {
    --thry-gradient-top: #4a4a4a;
    --thry-gradient-bottom: #424242;
}

.thry-inspector.thry-dark .unity-base-popup-field > .unity-base-popup-field__input {
    border-color: #222222;
}

.thry-inspector.thry-dark .unity-base-text-field__input {
    --thry-gradient-top: #272727;
    --thry-gradient-bottom: #303030;
}

.thry-inspector.thry-dark .thry-section-header {
    --thry-gradient-top: #4c4c4c;
    --thry-gradient-bottom: #3e3e3e;
}

.thry-inspector.thry-dark .thry-section-header:hover {
    --thry-gradient-top: #535353;
    --thry-gradient-bottom: #444444;
}

.thry-inspector.thry-dark .thry-subsection-panel > .thry-section-header {
    --thry-gradient-top: #474747;
    --thry-gradient-bottom: #3b3b3b;
}

.thry-inspector.thry-dark .thry-root-section > .thry-section-header {
    border-top-width: 1px;
    border-top-color: #262626;
}
