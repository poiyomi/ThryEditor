.thry-inspector.thry-light.thry-gray-light-n11, .thry-dropdown-menu.thry-light.thry-gray-light-n11 {
    --thry-surface-color: #d3d3d3;
    --thry-hover-color: #dddddd;
    --thry-input-background: #d2d2d2;
    --thry-field-background: #d2d2d2;
}

.thry-inspector.thry-light.thry-gray-light-p11, .thry-dropdown-menu.thry-light.thry-gray-light-p11 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p12, .thry-dropdown-menu.thry-light.thry-gray-light-p12 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p13, .thry-dropdown-menu.thry-light.thry-gray-light-p13 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p14, .thry-dropdown-menu.thry-light.thry-gray-light-p14 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p15, .thry-dropdown-menu.thry-light.thry-gray-light-p15 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p16, .thry-dropdown-menu.thry-light.thry-gray-light-p16 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p17, .thry-dropdown-menu.thry-light.thry-gray-light-p17 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p18, .thry-dropdown-menu.thry-light.thry-gray-light-p18 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p19, .thry-dropdown-menu.thry-light.thry-gray-light-p19 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

.thry-inspector.thry-light.thry-gray-light-p20, .thry-dropdown-menu.thry-light.thry-gray-light-p20 {
    --thry-surface-color: #ffffff;
    --thry-hover-color: #ffffff;
    --thry-input-background: #ffffff;
    --thry-field-background: #ffffff;
}

/* Text changes independently of the established control and checkbox sizes. */
.thry-inspector.thry-text-size-1, .thry-dropdown-menu.thry-text-size-1 {
    --thry-font-size: 11px;
    --thry-type-micro: 9px;
    --thry-type-caption: 10px;
    --thry-type-small: 10px;
    --thry-type-body-small: 11px;
    --thry-type-body: 12px;
    --thry-type-heading: 15px;
    --thry-type-title-compact: 16px;
    --thry-type-title: 17px;
}

.thry-inspector.thry-text-size-2, .thry-dropdown-menu.thry-text-size-2 {
    --thry-font-size: 13px;
    --thry-type-micro: 10px;
    --thry-type-caption: 11px;
    --thry-type-small: 12px;
    --thry-type-body-small: 13px;
    --thry-type-body: 14px;
    --thry-type-heading: 17px;
    --thry-type-title-compact: 18px;
    --thry-type-title: 19px;
}

.thry-inspector.thry-text-size-3, .thry-dropdown-menu.thry-text-size-3 {
    --thry-font-size: 14px;
    --thry-type-micro: 11px;
    --thry-type-caption: 12px;
    --thry-type-small: 13px;
    --thry-type-body-small: 14px;
    --thry-type-body: 15px;
    --thry-type-heading: 18px;
    --thry-type-title-compact: 19px;
    --thry-type-title: 20px;
}

/* Compact UV mask. Surfaces, typography and state colors come from the shared theme. */
.thry-uv-board {
    margin-top: var(--thry-space-4);
    margin-bottom: var(--thry-space-4);
}

.thry-uv-row {
    align-items: center;
}

.thry-inspector Button.thry-uv-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: var(--thry-control-height);
    margin: var(--thry-space-2);
    padding: 0 var(--thry-space-4);
    border-radius: var(--thry-radius-button);
    border-width: var(--thry-border-width);
    border-color: var(--thry-control-border-color);
    justify-content: center;
    align-items: stretch;
}

.thry-inspector Button.thry-uv-cell:hover {
    border-color: var(--thry-monokai-cyan);
}

.thry-uv-cell > .thry-uv-coordinate {
    font-size: var(--thry-type-small);
    color: var(--thry-value-color);
    -unity-text-align: middle-center;
    margin: 0;
}

.thry-uv-cell > .thry-uv-caption {
    font-size: var(--thry-type-caption);
    color: var(--thry-value-color);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
}

.thry-uv-cell > .thry-uv-state {
    position: absolute;
    top: var(--thry-space-3);
    right: var(--thry-space-3);
    padding: var(--thry-space-1) var(--thry-space-2);
    margin: 0;
    border-radius: var(--thry-radius-compact);
    font-size: var(--thry-type-micro);
    -unity-font-style: bold;
    color: var(--thry-animation-color);
    background-color: var(--thry-panel-background);
}

.thry-uv-cell > .thry-uv-state.thry-uv-ra {
    color: var(--thry-animation-renamed-color);
}

.thry-inspector Button.thry-uv-cell.thry-uv-discarded {
    --thry-button-background: var(--thry-monokai-pink-surface);
    --thry-button-hover-background: var(--thry-monokai-pink-surface-hover);
    --thry-button-pressed-background: var(--thry-monokai-pink-surface-pressed);
    --thry-button-disabled-background: var(--thry-monokai-pink-surface-disabled);
    border-color: var(--thry-monokai-pink-surface);
}

.thry-inspector Button.thry-uv-cell.thry-uv-mixed {
    border-color: var(--thry-monokai-purple);
}

.thry-inspector Button.thry-uv-cell:focus {
    border-color: var(--thry-focus-color);
}

/* Light skin contrast. Surfaces that read clearly on dark gray lose their edges on
   light gray, so these rules add the tone step the dark skin gets for free. */
.thry-dropdown-menu.thry-light .thry-menu-card {
    background-color: var(--thry-surface-color);
    border-color: #9a9a9a;
}

.thry-dropdown-menu.thry-light .thry-menu-selected {
    background-color: #afc9dd;
}

.thry-dropdown-menu.thry-light .thry-menu-separator {
    background-color: #b0b0b0;
}

/* Kept tiles read as fields; discarded tiles carry a saturated fill and outline. */
.thry-inspector.thry-light Button.thry-uv-cell {
    --thry-button-background: var(--thry-field-background);
    --thry-button-hover-background: #e8e8e8;
    --thry-button-pressed-background: #cfcfcf;
    --thry-button-disabled-background: var(--thry-disabled-background);
}

.thry-inspector.thry-light Button.thry-uv-cell.thry-uv-discarded {
    --thry-button-background: #e3a9bd;
    --thry-button-hover-background: #ebbccc;
    --thry-button-pressed-background: #d696ac;
    --thry-button-disabled-background: var(--thry-monokai-pink-surface-disabled);
    border-color: var(--thry-monokai-pink);
}

.thry-inspector.thry-light .thry-uv-cell.thry-uv-discarded > .thry-uv-caption {
    color: #7d0d33;
}

.thry-inspector.thry-light Button.thry-uv-cell.thry-uv-discarded:hover {
    border-color: var(--thry-monokai-cyan);
}

.thry-inspector.thry-light Button.thry-uv-cell.thry-uv-discarded:focus {
    border-color: var(--thry-focus-color);
}

/* ButtonVector, Vector4Toggles and multi-float tiles: off reads as a field, on as a
   filled accent. Borders are redeclared for each state because these selectors
   outrank the shared Button hover and focus rules. */
.thry-inspector.thry-light .thry-multi-value-controls > Button {
    --thry-button-background: var(--thry-field-background);
    --thry-button-hover-background: #e8e8e8;
    --thry-button-pressed-background: #cfcfcf;
    --thry-button-disabled-background: var(--thry-disabled-background);
    border-color: var(--thry-control-border-color);
}

.thry-inspector.thry-light .thry-multi-value-controls > Button.thry-selected {
    --thry-button-background: #a9c7de;
    --thry-button-hover-background: #b9d3e6;
    --thry-button-pressed-background: #98bbd5;
    border-color: var(--thry-accent-color);
}

.thry-inspector.thry-light .thry-multi-value-controls > Button.thry-tile-mixed {
    border-color: #777777;
}

.thry-inspector.thry-light .thry-multi-value-controls > Button:disabled {
    border-color: var(--thry-disabled-border);
}

.thry-inspector.thry-light .thry-multi-value-controls > Button:focus,
.thry-inspector.thry-light .thry-multi-value-controls > Button:enabled:active {
    border-color: var(--thry-focus-color);
}

/* In-row actions (bake, mask picker, prefab spawner, positioning) are raised light
   buttons rather than the toolbar gray, which matched root headers and hid icons. */
.thry-inspector.thry-light .thry-material-controls Button.thry-action-button,
.thry-inspector.thry-light .thry-material-controls Button.thry-mask-picker,
.thry-inspector.thry-light .thry-material-controls .thry-action-row Button {
    --thry-button-background: #e6e6e6;
    --thry-button-hover-background: #f0f0f0;
    --thry-button-pressed-background: #cfcfcf;
    --thry-button-disabled-background: var(--thry-disabled-background);
    border-color: #a8a8a8;
}

.thry-inspector.thry-light .thry-material-controls Button.thry-action-button.thry-selected,
.thry-inspector.thry-light .thry-material-controls Button.thry-action-button.thry-positioning-active {
    --thry-button-background: #a9c7de;
    --thry-button-hover-background: #b9d3e6;
    --thry-button-pressed-background: #98bbd5;
    border-color: var(--thry-accent-color);
}

.thry-inspector.thry-light .thry-material-controls Button.thry-action-button:disabled,
.thry-inspector.thry-light .thry-material-controls Button.thry-mask-picker:disabled,
.thry-inspector.thry-light .thry-material-controls .thry-action-row Button:disabled {
    border-color: var(--thry-disabled-border);
}

.thry-inspector.thry-light .thry-material-controls Button.thry-action-button:focus,
.thry-inspector.thry-light .thry-material-controls Button.thry-mask-picker:focus,
.thry-inspector.thry-light .thry-material-controls .thry-action-row Button:focus,
.thry-inspector.thry-light .thry-material-controls Button.thry-action-button:enabled:active,
.thry-inspector.thry-light .thry-material-controls Button.thry-mask-picker:enabled:active,
.thry-inspector.thry-light .thry-material-controls .thry-action-row Button:enabled:active {
    border-color: var(--thry-focus-color);
}
