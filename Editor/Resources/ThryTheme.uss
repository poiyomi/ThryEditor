/* Shared retained UI stylesheet. Edit this file to experiment with the inspector
   and companion windows. Compatibility sheets only import this file.
   See ../UI_STYLING.md for scope and examples. */
/* Shared shape, size, spacing and typography controls.
   The Studio treatment uses compact text and headers with full-height inputs.
   Override semantic tokens here rather
   than restyling individual controls. Zero radii on joined edges are intentional. */
.thry-inspector, .thry-dropdown-menu {
    --thry-radius-control: 3px;
    --thry-radius-button: var(--thry-radius-control);
    --thry-radius-header: 6px;
    --thry-radius-subheader: var(--thry-radius-header);
    --thry-radius-panel: 6px;
    --thry-radius-panel-small: var(--thry-radius-control);
    --thry-radius-card: 8px;
    --thry-radius-compact: 3px;
    --thry-radius-round: 7px;
    --thry-radius-switch: 8px;
    --thry-border-width: 1px;
    --thry-border-width-strong: 2px;
    --thry-control-height: 22px;
    --thry-button-height: 24px;
    --thry-toolbar-height: 26px;
    --thry-window-control-height: 28px;
    --thry-footer-icon-size: 32px;
    --thry-footer-button-size: 36px;
    --thry-ramp-height: 54px;
    /* Unitless values are read by the custom Painter2D ramp control. */
    --thry-ramp-stroke-width: 2;
    --thry-ramp-handle-radius: 4;
    --thry-ramp-line-color: rgb(122.4, 173.4, 214.2);
    --thry-ramp-handle-color: #cccccc;
    --thry-type-micro: 9px;
    --thry-type-caption: 10px;
    --thry-type-small: 11px;
    --thry-type-body-small: 12px;
    --thry-type-body: 13px;
    --thry-type-heading: 16px;
    --thry-type-title-compact: 17px;
    --thry-type-title: 18px;
    --thry-space-1: 1px;
    --thry-space-2: 2px;
    --thry-space-3: 3px;
    --thry-space-4: 4px;
    --thry-space-5: 5px;
    --thry-space-6: 6px;
    --thry-space-7: 7px;
    --thry-space-8: 8px;
    --thry-space-10: 10px;
    --thry-space-12: 12px;
    --thry-space-16: 16px;
    --thry-space-18: 18px;
    --thry-space-20: 20px;
}

/* Monokai accents shared by inspector controls and companion windows.
   Light-skin counterparts keep small labels legible on light surfaces.
   Neutral surfaces continue to use the shared Poiyomi gray theme below. */
.thry-inspector, .thry-dropdown-menu {
    --thry-monokai-pink: #f92672;
    --thry-monokai-pink-surface: #60434e;
    --thry-monokai-pink-surface-hover: #71505d;
    --thry-monokai-pink-surface-pressed: #513941;
    --thry-monokai-pink-surface-disabled: #4e4146;
    --thry-monokai-green: #a6e22e;
    --thry-monokai-yellow: #e6db74;
    --thry-monokai-orange: #fd971f;
    --thry-monokai-cyan: #66d9ef;
    --thry-monokai-purple: #ae81ff;
    --thry-monokai-foreground: #f8f8f2;
    --thry-animation-color: var(--thry-monokai-green);
    --thry-animation-renamed-color: var(--thry-monokai-yellow);
}

.thry-inspector.thry-light, .thry-dropdown-menu.thry-light {
    --thry-monokai-pink: #b9144c;
    --thry-monokai-pink-surface: #e2c3ce;
    --thry-monokai-pink-surface-hover: #edd2dc;
    --thry-monokai-pink-surface-pressed: #d6b5c0;
    --thry-monokai-pink-surface-disabled: #d2c4c9;
    --thry-monokai-green: #638f14;
    --thry-monokai-yellow: #82721e;
    --thry-monokai-orange: #b86509;
    --thry-monokai-cyan: #16798b;
    --thry-monokai-purple: #7545b8;
    --thry-monokai-foreground: #272822;
}

/* Shared palette: dark defaults, then Unity light-skin overrides. */
.thry-inspector, .thry-dropdown-menu {
    --thry-background-color: #383838;
    --thry-surface-color: #454545;
    --thry-hover-color: #4c4c4c;
    --thry-border-color: #4b4b4b;
    --thry-accent-color: #7aadd6;
    --thry-preset-color: var(--thry-monokai-cyan);
    --thry-preset-animation-color: var(--thry-monokai-purple);
    --thry-panel-background: #333333;
    --thry-root-section-text-color: var(--thry-value-color);
    --thry-action-text-color: var(--thry-value-color);
    --thry-root-section-background: #575757;
    --thry-root-section-hover-background: #626262;
    --thry-subsection-background: #494949;
    --thry-subsection-hover-background: #545454;
    --thry-control-border-color: #494949;
    --thry-field-background: var(--thry-input-background);
    --thry-dropdown-background: var(--thry-surface-color);
    --thry-dropdown-hover-background: var(--thry-hover-color);
    --thry-selection-background: #435563;
    --thry-channel-r-color: var(--thry-monokai-pink);
    --thry-channel-g-color: var(--thry-monokai-green);
    --thry-channel-b-color: var(--thry-monokai-cyan);
    --thry-channel-a-color: var(--thry-monokai-foreground);
}

.thry-inspector.thry-light, .thry-dropdown-menu.thry-light {
    --thry-background-color: #c8c8c8;
    --thry-surface-color: #dedede;
    --thry-hover-color: #e8e8e8;
    --thry-border-color: #b5b5b5;
    --thry-accent-color: #3b78a8;
    --thry-preset-color: var(--thry-monokai-cyan);
    --thry-preset-animation-color: var(--thry-monokai-purple);
    --thry-panel-background: #c9c9c9;
    --thry-root-section-background: #a0a0a0;
    --thry-root-section-hover-background: #ababab;
    --thry-subsection-background: #b6b6b6;
    --thry-subsection-hover-background: #bfbfbf;
    --thry-control-border-color: #b5b5b5;
    --thry-field-background: #dddddd;
    --thry-dropdown-background: #e1e1e1;
    --thry-dropdown-hover-background: #ebebeb;
    --thry-selection-background: #bfd1df;
    --thry-channel-r-color: var(--thry-monokai-pink);
    --thry-channel-g-color: var(--thry-monokai-green);
    --thry-channel-b-color: var(--thry-monokai-cyan);
    --thry-channel-a-color: var(--thry-monokai-foreground);
}

/* ===== ThryInspector ===== */
.thry-inspector, .thry-dropdown-menu {
    /* Inspector text size is independent of control heights and spacing. */
    --thry-font-size: 12px;
    --thry-section-height: 22px;
    --thry-nested-section-height: 20px;
    --thry-row-gap: 3px;
    --thry-focus-color: var(--thry-accent-color);
    --thry-caption-color: #dadada;
    --thry-muted-color: #bcbcbc;
    --thry-value-color: #e4e4e4;
    --thry-input-background: #292929;
    --thry-section-background: #4d4d4d;
}

.thry-light {
    --thry-focus-color: #326f9c;
    --thry-caption-color: #292929;
    --thry-muted-color: #606060;
    --thry-value-color: #292929;
}

/* Every retained Button uses this state machine, including newly added actions.
   Components own layout and icon colors; surface variants only override tokens.
   Disabled buttons still acknowledge hover, but Unity keeps their actions disabled. */
.thry-inspector, .thry-dropdown-menu {
    --thry-button-background: var(--thry-action-background);
    --thry-button-hover-background: var(--thry-action-hover-background);
    --thry-button-pressed-background: #414141;
    --thry-button-disabled-background: var(--thry-surface-color);
    --thry-button-selected-hover-background: #4d6273;
}

.thry-inspector.thry-light, .thry-dropdown-menu.thry-light {
    --thry-button-pressed-background: #c4c4c4;
    --thry-button-selected-hover-background: #cfe0ec;
}

.unity-button {
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
}

.thry-inspector Button, .thry-dropdown-menu Button {
    background-color: var(--thry-button-background);
    border-color: var(--thry-button-background);
    color: var(--thry-action-text-color);
}

.thry-inspector Button:disabled, .thry-dropdown-menu Button:disabled {
    background-color: var(--thry-button-disabled-background);
    border-color: var(--thry-button-disabled-background);
    color: var(--thry-muted-color);
}

.thry-inspector Button:disabled > Label, .thry-dropdown-menu Button:disabled > Label {
    color: var(--thry-muted-color);
}

.thry-inspector Button:hover, .thry-dropdown-menu Button:hover {
    background-color: var(--thry-button-hover-background);
    border-color: var(--thry-button-hover-background);
}

.thry-inspector Button:enabled:active, .thry-dropdown-menu Button:enabled:active {
    background-color: var(--thry-button-pressed-background);
    border-color: var(--thry-focus-color);
}

.thry-inspector Button:focus, .thry-dropdown-menu Button:focus {
    border-color: var(--thry-focus-color);
}

/* Icon, navigation, and inline buttons share interaction states on a clear surface. */
.thry-inspector .thry-icon-button,
.thry-inspector .thry-text-button,
.thry-inspector .thry-header-action,
.thry-inspector .thry-fold-arrow,
.thry-inspector .thry-footer Button,
.thry-inspector .thry-saved-filters,
.thry-inspector .thry-asset-clear,
.thry-inspector .thry-texture-clear,
.thry-inspector .thry-preset-small-action,
.thry-inspector .thry-studio-node-field > Button,
.thry-inspector .pathing-lane-label,
.thry-inspector .pathing-cell > Button,
.thry-inspector .thry-search Button {
    --thry-button-background: transparent;
    --thry-button-disabled-background: transparent;
}

/* Texture disclosure labels are part of the field row, with no button box. */
.thry-inspector .thry-texture-label {
    --thry-button-background: transparent;
    --thry-button-hover-background: transparent;
    --thry-button-pressed-background: transparent;
    --thry-button-disabled-background: transparent;
    border-width: 0;
}

.thry-inspector Button.thry-selected,
.thry-inspector Button.thry-positioning-active {
    --thry-button-background: var(--thry-selection-background);
    --thry-button-hover-background: var(--thry-button-selected-hover-background);
}

.thry-inspector.thry-active {
    background-color: var(--thry-background-color);
    padding-bottom: var(--thry-space-8);
}

.thry-chrome {
    --thry-toolbar-height: var(--thry-control-height);
    --thry-button-height: 20px;
    padding: var(--thry-space-4) var(--thry-space-3) var(--thry-space-4) var(--thry-space-3);
}

.thry-masthead {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--thry-space-4);
}

.thry-branding {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 100px;
}

.thry-title-row {
    flex-direction: row;
    align-items: center;
}

.thry-title {
    -unity-font-style: bold;
    font-size: var(--thry-type-title);
    margin: 0;
    color: #e4e4e4;
    white-space: normal;
    flex-shrink: 1;
}

.thry-version {
    font-size: var(--thry-type-caption);
    color: var(--thry-muted-color);
    margin-left: var(--thry-space-8);
    margin-top: 0;
    background-color: #414141;
    padding: var(--thry-space-2) var(--thry-space-5);
    border-radius: var(--thry-radius-compact);
}

.thry-state {
    font-size: var(--thry-type-caption);
    color: var(--thry-muted-color);
    margin: var(--thry-space-3) 0 0 0;
}

.thry-state.thry-optimized {
    color: var(--thry-monokai-green);
}

.thry-tools {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: var(--thry-space-8);
}

.thry-icon-button {
    width: 26px;
    height: var(--thry-toolbar-height);
    padding: var(--thry-space-3);
    margin: 0 0 0 var(--thry-space-3);
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
}

.thry-icon-button Image {
    width: 18px;
    height: 18px;
}

.thry-chrome .thry-icon-button {
    width: var(--thry-control-height);
    padding: var(--thry-space-1);
}

.thry-navigation-group {
    padding-bottom: 0;
}

.thry-navigation {
    flex-direction: row;
    align-items: center;
}

.thry-search {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 70px;
    max-width: none;
    height: var(--thry-toolbar-height);
    margin: 0;
    background-color: var(--thry-input-background);
    border-color: #2c2c2c;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-panel);
}

.thry-search .unity-search-field-base__text-field {
    height: var(--thry-button-height);
    min-height: var(--thry-button-height);
    margin: 0 0 0 var(--thry-space-5);
    padding: 0;
    align-self: center;
}

.thry-search .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: #e4e4e4;
    height: var(--thry-button-height);
    min-height: var(--thry-button-height);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    font-size: var(--thry-font-size);
}

.thry-search.thry-search-focused {
    border-color: var(--thry-focus-color);
}

.thry-search .unity-text-element--inner-input-field-component {
    -unity-text-align: middle-left;
    font-size: var(--thry-font-size);
    height: var(--thry-button-height);
    margin: 0;
    padding: 0;
}

.thry-search .unity-search-field-base__search-button, .thry-search .unity-search-field-base__cancel-button {
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
}

.thry-search .unity-search-field-base__search-button {
    width: 18px;
    height: 18px;
    min-width: 18px;
    padding: 0;
}

.thry-search-placeholder {
    position: absolute;
    left: 25px;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    color: var(--thry-muted-color);
    font-size: var(--thry-font-size);
}

.thry-search-filters {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: var(--thry-space-5);
}

.thry-type-picker {
    width: 100px;
    flex-shrink: 0;
    height: var(--thry-toolbar-height);
    margin: 0;
}

.thry-type-picker .unity-base-field__input {
    background-color: #484848;
    border-color: #545454;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-panel);
    padding-left: 9px;
}

.thry-type-picker .unity-base-popup-field__text {
    color: #d4d4d4;
    font-size: var(--thry-type-body-small);
}

.thry-text-button {
    border-width: 0;
    color: var(--thry-caption-color);
    font-size: var(--thry-font-size);
    margin: 0;
    padding: var(--thry-space-2) 0;
}

.thry-text-button:hover {
    color: var(--thry-accent-color);
}

.thry-text-button:focus {
    color: var(--thry-accent-color);
}

.thry-material-controls {
    margin-left: 0;
    margin-right: 0;
}

.thry-empty {
    padding: var(--thry-space-20) var(--thry-space-12);
    margin: var(--thry-space-4) var(--thry-space-8);
    border-radius: var(--thry-radius-card);
    background-color: var(--thry-background-color);
    color: var(--thry-muted-color);
    font-size: var(--thry-type-body-small);
}

.thry-empty-title {
    color: #e4e4e4;
    -unity-font-style: bold;
    font-size: var(--thry-font-size);
    margin-bottom: var(--thry-space-4);
}

.thry-compact .thry-title {
    font-size: var(--thry-type-title-compact);
}

.thry-compact .thry-version {
    margin-left: var(--thry-space-5);
}

.thry-narrow .thry-masthead {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: var(--thry-space-8);
}

.thry-narrow .thry-tools {
    margin: var(--thry-space-4) 0 0 -3px;
}

.thry-changed-filter {
    height: var(--thry-toolbar-height);
    margin: 0 0 0 var(--thry-space-5);
    padding: 0 var(--thry-space-7);
    flex-shrink: 0;
    background-color: #484848;
    border-width: var(--thry-border-width);
    border-color: #545454;
    border-radius: var(--thry-radius-panel);
}

.thry-changed-filter .unity-base-field__input {
    align-items: center;
    padding: 0;
    background-color: transparent;
}

.thry-changed-filter .unity-toggle__text {
    color: #d4d4d4;
    font-size: var(--thry-type-body-small);
    margin-left: var(--thry-space-5);
}

.thry-changed-filter:hover {
    background-color: var(--thry-border-color);
}

.thry-changed-filter:focus {
    border-color: var(--thry-focus-color);
}

.thry-compact .thry-navigation {
    flex-direction: column;
    align-items: stretch;
}

.thry-compact .thry-navigation > .thry-search {
    flex-shrink: 0;
    width: auto;
    align-self: stretch;
}

.thry-compact .thry-search-filters {
    margin: var(--thry-space-4) 0 0 0;
}

.thry-compact .thry-type-picker {
    flex-grow: 1;
}

.thry-compact .thry-changed-filter {
    flex-grow: 1;
}

.thry-light .thry-changed-filter {
    background-color: var(--thry-surface-color);
    border-color: var(--thry-border-color);
}

.thry-light .thry-changed-filter .unity-toggle__text {
    color: #454545;
}

.thry-light.thry-active {
    background-color: var(--thry-background-color);
    color: #252525;
}

.thry-light .thry-title {
    color: #252525;
}

.thry-light .thry-version {
    background-color: var(--thry-surface-color);
}

.thry-light .thry-version, .thry-light .thry-state, .thry-light .thry-text-button {
    color: #5b5b5b;
}

.thry-light .thry-search {
    background-color: #ffffff;
    border-color: var(--thry-border-color);
}

.thry-light .thry-search .unity-base-text-field__input {
    color: #252525;
}

.thry-light .thry-search.thry-search-focused {
    border-color: var(--thry-accent-color);
}

.thry-light .thry-type-picker .unity-base-field__input {
    background-color: var(--thry-surface-color);
    border-color: var(--thry-border-color);
}

.thry-light .thry-type-picker .unity-base-popup-field__text, .thry-light .thry-language .unity-base-popup-field__text {
    color: #454545;
}

.thry-light .thry-search-placeholder {
    color: #696969;
}

.thry-light .thry-state.thry-optimized {
    color: #4c7020;
}

.thry-light .thry-empty {
    background-color: var(--thry-surface-color);
    color: #5b5b5b;
}

.thry-light .thry-empty-title {
    color: #252525;
}

.thry-dropdown-menu {
    position: absolute;
}

.thry-dropdown-menu .unity-base-dropdown__container-outer {
    position: absolute;
    background-color: var(--thry-background-color);
    border-color: #555555;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-card);
    padding: 0;
}

.thry-dropdown-menu .unity-base-dropdown__container-inner {
    background-color: var(--thry-background-color);
    border-width: 0;
    padding: var(--thry-space-4);
    flex-shrink: 0;
}

.thry-dropdown-menu .unity-base-dropdown__item {
    flex-direction: row;
    align-items: center;
    height: var(--thry-menu-item-height);
    min-height: var(--thry-menu-item-height);
    margin: 0;
    padding: 0 var(--thry-space-8);
    border-radius: var(--thry-radius-panel-small);
}

.thry-dropdown-menu .unity-base-dropdown__checkmark {
    width: 16px;
    height: 16px;
    margin-right: var(--thry-space-6);
}

.thry-dropdown-menu .unity-base-dropdown__label {
    color: #e4e4e4;
    font-size: var(--thry-font-size);
    -unity-text-align: middle-left;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.thry-dropdown-menu .unity-base-dropdown__item:hover, .thry-dropdown-menu .unity-base-dropdown__item:checked {
    background-color: var(--thry-hover-color);
}

.thry-dropdown-menu.thry-light .unity-base-dropdown__container-outer, .thry-dropdown-menu.thry-light .unity-base-dropdown__container-inner {
    background-color: var(--thry-surface-color);
    border-color: var(--thry-border-color);
}

.thry-dropdown-menu.thry-light .unity-base-dropdown__label {
    color: #252525;
}

.thry-dropdown-menu.thry-light .unity-base-dropdown__item:hover, .thry-dropdown-menu.thry-light .unity-base-dropdown__item:checked {
    background-color: #eeeeee;
}

/* Native material controls share one responsive label/value grid. */
.thry-material-controls {
    --thry-control-height: 18px;
    --thry-property-checkbox-size: 16px;
    margin: 0 var(--thry-space-3);
}

.thry-property-height-18 .thry-material-controls {
    --thry-control-height: 18px;
}

.thry-property-height-20 .thry-material-controls {
    --thry-control-height: 20px;
    --thry-property-checkbox-size: 18px;
}

.thry-property-height-22 .thry-material-controls {
    --thry-control-height: 22px;
    --thry-property-checkbox-size: 18px;
}

/* Menu rows follow the property height with a small hit-target margin.
   RetainedMenu.RowHeight mirrors these values to size the menu card. */
.thry-dropdown-menu {
    --thry-menu-item-height: 22px;
}

.thry-dropdown-menu.thry-property-height-20 {
    --thry-menu-item-height: 24px;
}

.thry-dropdown-menu.thry-property-height-22 {
    --thry-menu-item-height: 26px;
}

.thry-property-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--thry-control-height);
    margin: var(--thry-space-1) 0;
}

.thry-property-label {
    width: 38%;
    flex-shrink: 0;
    margin: 0;
    padding: 0 var(--thry-space-8) 0 0;
    -unity-text-align: middle-left;
    color: var(--thry-caption-color);
    font-size: var(--thry-font-size);
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-property-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.thry-property-value > .unity-base-field {
    margin: 0;
    min-width: 0;
    min-height: var(--thry-control-height);
}

/* One outer height for ordinary material drawers. Cap flex growth so table
   cells cannot stretch dropdowns/colors beyond the neighbouring number fields.
   Multi-row and preview containers keep their content-driven height. */
.thry-material-controls .thry-property-value > .unity-base-field,
.thry-material-controls .thry-components > .thry-component,
.thry-material-controls .thry-special-slider-row > .unity-base-field,
.thry-material-controls .unity-base-slider .unity-base-text-field,
.thry-material-controls .pathing-cell > .unity-base-field,
.thry-material-controls .thry-property > .thry-action-button,
.thry-material-controls .thry-property-value > Button,
.thry-material-controls .thry-property-value > .thry-components > Button {
    height: var(--thry-control-height);
    min-height: var(--thry-control-height);
    max-height: var(--thry-control-height);
}

/* Inline references share their parent row's spacing. */
.thry-material-controls .thry-property-row.thry-inline {
    margin-top: 0;
    margin-bottom: 0;
}

/* Normalize visible field surfaces as well as their outer control boxes. */
.thry-material-controls .unity-base-text-field__input,
.thry-material-controls .unity-base-popup-field__input,
.thry-material-controls .unity-object-field__input,
.thry-material-controls .unity-color-field__input {
    height: var(--thry-control-height);
    min-height: var(--thry-control-height);
    max-height: var(--thry-control-height);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-self: center;
}

.thry-material-controls .thry-property-value > .unity-toggle > .unity-toggle__input {
    height: var(--thry-control-height);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* High-resolution tick artwork keeps property checkboxes crisp. */
.thry-material-controls .thry-property-value > .unity-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    width: var(--thry-property-checkbox-size);
    min-width: var(--thry-property-checkbox-size);
    height: var(--thry-property-checkbox-size);
    min-height: var(--thry-property-checkbox-size);
    align-self: center;
    background-image: none;
    -unity-background-scale-mode: scale-to-fit;
}

.thry-material-controls .thry-property-value > .unity-toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: url("ThryToolbar/property-checkmark.png");
    -unity-background-image-tint-color: var(--thry-value-color);
}

.thry-input, .thry-component {
    font-size: var(--thry-font-size);
}

.thry-material-controls .unity-base-text-field__input, .thry-material-controls .unity-base-popup-field__input, .thry-material-controls .unity-object-field__input {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-control);
    min-height: var(--thry-control-height);
    padding: 0 var(--thry-space-6);
    -unity-text-align: middle-left;
}

.thry-material-controls .unity-base-text-field__input:focus, .thry-material-controls .unity-base-popup-field__input:focus {
    border-color: var(--thry-focus-color);
}

.thry-material-controls .unity-base-slider .unity-base-text-field {
    width: 54px;
    margin: 0 0 0 var(--thry-space-6);
}

.thry-material-controls .unity-base-slider__drag-container {
    margin: 0 var(--thry-space-4);
    min-height: var(--thry-control-height);
}

.thry-components {
    flex-direction: row;
    flex-grow: 1;
    min-width: 0;
}

.thry-components > .thry-component {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.thry-component > .unity-base-field__label {
    min-width: 10px;
    width: auto;
    margin: 0 var(--thry-space-4) 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: var(--thry-muted-color);
}

.thry-inline .thry-property-label {
    display: none;
}

.thry-inline {
    flex-grow: 1;
}

/* Header height preferences are scoped to section bars. */
.thry-header-height-18 .thry-section-header {
    --thry-section-height: 18px;
    --thry-nested-section-height: 18px;
}

.thry-header-height-20 .thry-section-header {
    --thry-section-height: 20px;
    --thry-nested-section-height: 18px;
}

.thry-header-height-22 .thry-section-header {
    --thry-section-height: 22px;
    --thry-nested-section-height: 20px;
}

.thry-header-height-24 .thry-section-header {
    --thry-section-height: 24px;
    --thry-nested-section-height: 22px;
}

/* At the default height, a collapsed root header plus this gap occupies 24px. */
.thry-section {
    margin: 0 0 var(--thry-space-2);
}

.thry-section-header {
    flex-direction: row;
    align-items: center;
    height: var(--thry-nested-section-height);
    background-color: #494949;
    border-radius: var(--thry-radius-subheader);
    padding: 0 var(--thry-space-4);
    overflow: hidden;
    border-color: #494949;
}

.thry-root-section > .thry-section-header {
    height: var(--thry-section-height);
    background-color: var(--thry-section-background);
    border-radius: var(--thry-radius-header);
    border-color: var(--thry-section-background);
}

.thry-section-title-area {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 var(--thry-space-4);
}

.thry-section-title {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    -unity-font-style: bold;
    margin: 0;
    font-size: var(--thry-font-size);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.thry-header-animation-dot, .thry-section-changed-dot {
    width: 5px;
    height: 5px;
    min-width: 5px;
    min-height: 5px;
    flex-shrink: 0;
    margin-left: var(--thry-space-5);
    border-radius: var(--thry-radius-compact);
}

.thry-section-content {
    padding: var(--thry-space-4) 0 var(--thry-space-4) var(--thry-space-8);
}

.thry-root-section > .thry-section-content {
    padding-top: var(--thry-space-7);
}

.thry-header-action,
.thry-fold-arrow {
    border-width: 0;
    border-radius: var(--thry-radius-compact);
    width: 24px;
    height: 100%;
    min-height: 0;
    min-width: 24px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    color: #b8b8b8;
}

.thry-header-action {
    width: 20px;
    min-width: 20px;
}

.thry-header-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    --unity-image-tint-color: #b8b8b8;
}

.thry-fold-arrow .thry-header-icon {
    width: 14px;
    height: 14px;
}

.thry-linked .thry-header-icon {
    --unity-image-tint-color: var(--thry-accent-color);
}

.thry-light .thry-header-icon {
    --unity-image-tint-color: #5d5d5d;
}

.thry-light .thry-linked .thry-header-icon {
    --unity-image-tint-color: #326f9c;
}

.thry-section-header > .thry-fold-arrow:hover,
.thry-section-header > .thry-fold-arrow:active,
.thry-section-header > .thry-fold-arrow:focus {
    border-width: 0;
}

.thry-fold-arrow:focus .thry-header-icon {
    --unity-image-tint-color: #e4e4e4;
}

.thry-light .thry-fold-arrow:focus .thry-header-icon {
    --unity-image-tint-color: #252525;
}

.thry-header-reference .unity-toggle {
    margin: 0;
}

.thry-material-controls .unity-toggle__input {
    align-items: center;
}

.thry-material-controls .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    margin: 0;
    border-radius: var(--thry-radius-compact);
    background-color: var(--thry-input-background);
    border-color: #535353;
    border-width: var(--thry-border-width);
}

.thry-section-switch {
    margin: 0 var(--thry-space-5) 0 0;
}

.thry-section-switch .unity-toggle__checkmark {
    width: 30px;
    height: 16px;
    border-radius: var(--thry-radius-switch);
    background-image: none;
}

.thry-excluded {
    background-color: #3d3d3d;
    color: #858585;
}

.thry-excluded .thry-section-title {
    color: #858585;
}

.thry-texture-label {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 0;
}

.thry-texture-label .thry-texture-caret {
    width: 14px;
    height: 14px;
    margin-right: var(--thry-space-2);
}

.thry-texture-caption {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--thry-font-size);
}

.thry-texture-details {
    background-color: #333333;
    padding: var(--thry-space-8);
    margin: var(--thry-space-3) 0 var(--thry-space-5);
    border-radius: var(--thry-radius-panel);
}

.thry-texture-preview {
    height: 80px;
    margin-bottom: var(--thry-space-6);
}

.thry-lock-button {
    font-size: var(--thry-font-size);
    height: var(--thry-section-height);
    margin: 0 0 var(--thry-space-3);
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
}

.thry-section-toolbar {
    flex-direction: row;
    padding: var(--thry-space-2);
    margin-bottom: var(--thry-space-6);
}

.thry-section-toolbar Button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 var(--thry-space-1);
    height: var(--thry-toolbar-height);
    border-width: 0;
    border-radius: var(--thry-radius-button);
}

.thry-footer {
    flex-direction: row;
    align-items: center;
    margin-top: var(--thry-space-16);
}

.thry-footer-credit {
    flex-grow: 1;
    font-size: var(--thry-type-caption);
    color: var(--thry-muted-color);
}

.thry-footer Button {
    width: var(--thry-footer-button-size);
    height: var(--thry-footer-button-size);
    border-width: 0;
    margin: 0 var(--thry-space-2);
    padding: var(--thry-space-2);
    align-items: center;
    justify-content: center;
}

.thry-footer Image {
    width: var(--thry-footer-icon-size);
    height: var(--thry-footer-icon-size);
    flex-shrink: 0;
}

.thry-animation-letter {
    width: 18px;
    min-width: 18px;
    height: 16px;
    flex-shrink: 0;
    margin: 0 var(--thry-space-2) 0 0;
    padding: 0;
    font-size: var(--thry-type-micro);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.thry-recording > .thry-property-row > .thry-property-value {
    border-left-width: var(--thry-border-width-strong);
    border-left-color: var(--thry-monokai-pink);
}

.thry-field-heading {
    -unity-font-style: bold;
    margin-top: var(--thry-space-8);
    margin-bottom: var(--thry-space-4);
}

.thry-description {
    white-space: normal;
    overflow: hidden;
    margin: var(--thry-space-3) 0;
}

#thry-separator {
    height: 1px;
    background-color: #444444;
    margin: var(--thry-space-4) 0;
}

.thry-material-actions {
    flex-shrink: 0;
    margin-bottom: var(--thry-space-4);
}

.thry-material-actions > .thry-lock-button {
    margin-bottom: var(--thry-space-2);
}

.thry-material-actions > .thry-presets-row {
    margin-bottom: 0;
}

.thry-presets-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--thry-space-8);
}

.thry-presets-row > * {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.thry-presets-row > Button {
    font-size: var(--thry-font-size);
    height: var(--thry-section-height);
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
    margin: 0 var(--thry-space-2) 0 0;
}

.thry-rendering-mode .thry-property-row {
    height: var(--thry-section-height);
    min-height: var(--thry-section-height);
    margin: 0;
}

.thry-rendering-mode .unity-base-popup-field {
    height: var(--thry-section-height);
    min-height: var(--thry-section-height);
    margin: 0;
}

.thry-rendering-mode .unity-base-popup-field__input {
    height: var(--thry-section-height);
    min-height: var(--thry-section-height);
    background-color: #505050;
    border-color: #606060;
    padding-left: var(--thry-space-10);
}

.thry-rendering-mode .unity-base-popup-field__input:hover {
    background-color: #5a5a5a;
    border-color: #707070;
}

.thry-rendering-mode .unity-base-popup-field__text {
    -unity-text-align: middle-left;
    font-size: var(--thry-font-size);
}

.thry-light .thry-rendering-mode .unity-base-popup-field__input {
    background-color: var(--thry-surface-color);
    border-color: var(--thry-border-color);
}

.thry-light .thry-rendering-mode .unity-base-popup-field__input:hover {
    background-color: #eeeeee;
    border-color: #a0a0a0;
}

.thry-with-reference {
    flex-direction: row-reverse;
    align-items: center;
}

.thry-with-reference > * {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.thry-with-reference > .thry-property {
    margin-left: var(--thry-space-4);
}

.thry-ramp {
    background-color: var(--thry-input-background);
    border-radius: var(--thry-radius-panel-small);
    margin-bottom: var(--thry-space-4);
}

.thry-components > Button {
    min-width: 0;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
}

.thry-property-label {
    min-width: 40px;
    max-width: none;
}

.thry-window {
    padding: var(--thry-space-12);
    min-width: 0;
}

.thry-window .unity-foldout {
    margin: var(--thry-space-8) 0;
}

.thry-window .unity-foldout__toggle {
    min-height: var(--thry-window-control-height);
    background-color: #414141;
    border-radius: var(--thry-radius-control);
    -unity-font-style: bold;
    border-color: #414141;
}

.thry-window .unity-base-text-field__input, .thry-window .unity-base-popup-field__input {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-control);
    min-height: var(--thry-control-height);
    padding: 0 var(--thry-space-6);
}

/* Native popup text can otherwise push choice controls above the shared input height. */
.thry-material-controls .unity-base-popup-field,
.thry-window .unity-base-popup-field {
    height: var(--thry-control-height);
    min-height: var(--thry-control-height);
}

/* Inset the borderless fill like the inside of an outlined text input, while
   keeping the field's full shared height and click target. */
.thry-material-controls .unity-base-popup-field__input,
.thry-window .unity-base-popup-field__input {
    height: auto;
    min-height: 0;
    margin: var(--thry-border-width);
}

.thry-material-controls .unity-base-popup-field__text,
.thry-window .unity-base-popup-field__text {
    margin-top: 0;
    margin-bottom: 0;
}

.thry-window Button {
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
    min-height: var(--thry-toolbar-height);
}

.thry-material-controls .unity-foldout__toggle .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
}

.thry-switch-knob {
    position: absolute;
    top: 2px;
    width: 10px;
    height: 10px;
    border-radius: var(--thry-radius-panel);
    background-color: #bcbcbc;
}

.thry-note {
    font-size: var(--thry-type-caption);
    color: var(--thry-muted-color);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-material-controls .unity-help-box {
    background-color: #3d3d3d;
    border-color: #505050;
    border-radius: var(--thry-radius-control);
    padding: var(--thry-space-5) var(--thry-space-6);
}

.thry-inspector .unity-help-box__label, .thry-window .unity-help-box__label {
    font-size: var(--thry-font-size);
    white-space: normal;
    -unity-font-style: normal;
    color: var(--thry-caption-color);
}

.thry-light .unity-help-box__label {
    color: #292929;
}

.thry-inspector .unity-help-box__icon, .thry-window .unity-help-box__icon {
    width: 22px;
    height: var(--thry-control-height);
    min-width: 22px;
    min-height: var(--thry-control-height);
    flex-shrink: 0;
    align-self: center;
    margin: 0 var(--thry-space-8) 0 0;
    -unity-background-scale-mode: scale-to-fit;
}

.thry-light .thry-material-controls .unity-help-box {
    background-color: #d4d4d4;
    border-color: #aaaaaa;
}

.thry-stencil {
    background-color: #333333;
    padding: var(--thry-space-8);
    margin-bottom: var(--thry-space-6);
    border-radius: var(--thry-radius-panel);
}

.thry-light .thry-section-header, .thry-light.thry-window .unity-foldout__toggle {
    background-color: #b4b4b4;
    border-color: #b4b4b4;
}

.thry-light .thry-root-section > .thry-section-header {
    background-color: #b4b4b4;
    border-color: #b4b4b4;
}

.thry-light .thry-property-label, .thry-light .thry-section-title {
    color: #292929;
}

.thry-light .thry-texture-details, .thry-light .thry-stencil {
    background-color: #c9c9c9;
}

.thry-light .thry-material-controls .unity-base-text-field__input, .thry-light .thry-material-controls .unity-base-popup-field__input, .thry-light .thry-material-controls .unity-object-field__input, .thry-light.thry-window .unity-base-text-field__input, .thry-light.thry-window .unity-base-popup-field__input {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
    color: #292929;
}

.thry-light .thry-material-controls .unity-toggle__checkmark {
    background-color: #e4e4e4;
    border-color: #999999;
}

.thry-light .thry-excluded {
    background-color: #ababab;
}

.thry-texture-workspace {
    padding: var(--thry-space-16);
}

.thry-studio-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-top: var(--thry-space-12);
    margin-bottom: var(--thry-space-12);
}

.thry-studio-controls {
    flex-basis: 56%;
    flex-grow: 1;
    margin-right: var(--thry-space-16);
}

.thry-studio-preview {
    flex-basis: 40%;
    flex-grow: 1;
    min-width: 200px;
    padding: var(--thry-space-12);
    background-color: #303030;
    border-radius: var(--thry-radius-card);
}

.thry-studio-preview > .unity-image {
    margin-bottom: var(--thry-space-12);
}

.thry-studio-section {
    margin-top: var(--thry-space-6);
    margin-bottom: var(--thry-space-6);
}

.thry-studio-section > .unity-foldout__toggle {
    min-height: var(--thry-window-control-height);
    background-color: #444444;
    border-radius: var(--thry-radius-control);
    padding-left: var(--thry-space-6);
    -unity-font-style: bold;
    border-color: #444444;
}

.thry-studio-section .unity-foldout__content {
    margin-left: var(--thry-space-8);
    padding-top: var(--thry-space-4);
}

.thry-studio-route {
    padding: var(--thry-space-8);
    margin-bottom: var(--thry-space-6);
    background-color: #303030;
    border-radius: var(--thry-radius-control);
}

.thry-studio-columns .unity-base-field__label {
    min-width: 90px;
    width: 38%;
}

.thry-studio-columns .unity-base-field {
    min-height: var(--thry-button-height);
    margin-bottom: var(--thry-space-4);
}

.thry-studio-columns .unity-base-field__input {
    min-width: 0;
}

.thry-studio-columns .thry-components .unity-base-field__label {
    min-width: 0;
    width: auto;
}

.thry-primary-action {
    min-height: 32px;
    -unity-font-style: bold;
}

.thry-light .thry-studio-preview, .thry-light .thry-studio-route {
    background-color: #c5c5c5;
}

.thry-light .thry-studio-section > .unity-foldout__toggle {
    background-color: #b9b9b9;
    border-color: #b9b9b9;
}

.thry-menu-card {
    background-color: var(--thry-background-color);
    border-color: #575757;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-panel);
    padding: var(--thry-space-4);
}

.thry-menu-item {
    flex-direction: row;
    align-items: center;
    min-height: var(--thry-menu-item-height);
    max-height: var(--thry-menu-item-height);
    padding: 0 var(--thry-space-8);
    border-radius: var(--thry-radius-compact);
}

.thry-menu-item Label {
    color: #dedede;
    font-size: var(--thry-font-size);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-menu-item .thry-menu-check {
    width: 18px;
    flex-shrink: 0;
    margin-right: var(--thry-space-4);
}

.thry-menu-selected {
    background-color: #505050;
}

.thry-menu-disabled {
    opacity: .45;
}

.thry-menu-separator {
    height: 1px;
    margin: var(--thry-space-4) var(--thry-space-6);
    background-color: #505050;
}

.thry-light .thry-menu-card {
    background-color: var(--thry-surface-color);
    border-color: #a8a8a8;
}

.thry-light .thry-menu-item Label {
    color: #252525;
}

.thry-light .thry-menu-selected {
    background-color: var(--thry-caption-color);
}

.thry-texture-summary {
    flex-direction: row;
    align-items: center;
    padding-bottom: var(--thry-space-8);
    margin-bottom: var(--thry-space-4);
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: #414141;
}

.thry-texture-summary .thry-texture-preview {
    width: 64px;
    height: 64px;
    margin: 0 var(--thry-space-12) 0 0;
    flex-shrink: 0;
    background-color: #292929;
    border-radius: var(--thry-radius-control);
}

.thry-texture-name {
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-muted {
    color: #a0a0a0;
    font-size: var(--thry-type-body-small);
    white-space: normal;
}

.thry-studio-source {
    margin: var(--thry-space-4) 0;
    padding: var(--thry-space-6) var(--thry-space-8);
    background-color: #323232;
    border-radius: var(--thry-radius-panel-small);
}

.thry-studio-source > .thry-components > Label {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.thry-studio-source > .thry-components > .unity-popup-field {
    width: 100px;
    flex-grow: 0;
}

.thry-studio-source > .thry-studio-section > .unity-foldout__toggle {
    background-color: transparent;
    min-height: var(--thry-control-height);
    -unity-font-style: normal;
    color: #a8a8a8;
    border-color: transparent;
}

.thry-studio-source .thry-studio-section {
    margin: 0;
}

.thry-footer {
    flex-wrap: wrap;
}

.thry-footer-credit {
    min-width: 110px;
    margin-bottom: var(--thry-space-4);
}

.thry-footer Button {
    flex-shrink: 0;
}

.thry-material-controls .unity-base-popup-field__text {
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-excluded .thry-header-action, .thry-excluded .thry-fold-arrow, .thry-excluded .thry-header-reference {
    opacity: .55;
}

.thry-window > .thry-components {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: var(--thry-window-control-height);
    margin: var(--thry-space-4) 0;
}

.thry-window > .thry-components > .unity-base-field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.thry-lock-manager .unity-base-field__label {
    min-width: 64px;
    width: 64px;
}

.thry-lock-manager > .unity-toggle > .unity-base-field__label {
    min-width: 120px;
    width: 120px;
}

.thry-window .thry-search .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.thry-window .thry-search Button {
    min-height: 14px;
    height: 14px;
    width: 14px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
}

.thry-window .thry-search {
    flex-grow: 0;
    flex-shrink: 0;
}

.thry-window > .thry-components > .thry-search {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Auxiliary windows use the inspector's controls without its material label grid. */
.thry-settings > .thry-search {
    width: auto;
    max-width: none;
    align-self: stretch;
}

.thry-settings .thry-property-label {
    width: 52%;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
}

.thry-settings .thry-property-row {
    min-height: var(--thry-button-height);
}

.thry-settings .thry-property-value > .unity-toggle,
.thry-lock-manager > .unity-toggle {
    align-items: center;
}

.thry-settings .thry-property-value .unity-toggle__input,
.thry-lock-manager > .unity-toggle .unity-toggle__input {
    align-items: center;
}

.thry-settings .thry-property-value .unity-toggle__checkmark,
.thry-lock-manager > .unity-toggle .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin: 0;
    border-radius: var(--thry-radius-compact);
    background-color: var(--thry-input-background);
    border-color: #535353;
    border-width: var(--thry-border-width);
}

.thry-light.thry-settings .thry-property-value .unity-toggle__checkmark,
.thry-light.thry-lock-manager > .unity-toggle .unity-toggle__checkmark {
    background-color: #e4e4e4;
    border-color: #999999;
}

/* Keep the object picker inside the field, beside its single text surface. */
.thry-material-controls .unity-object-field__input {
    flex-direction: row;
    align-items: center;
    padding-left: 0;
    padding-right: 0;
}

.thry-material-controls .unity-object-field-display {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    height: 20px;
}

.thry-material-controls .unity-object-field-display__icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
}

.thry-material-controls .unity-object-field-display__label {
    flex-shrink: 1;
    min-width: 0;
    margin: 0 0 0 var(--thry-space-5);
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-asset-tile {
    width: 24px;
    min-width: 24px;
    height: 20px;
    flex-shrink: 0;
    background-color: #363636;
    border-right-width: var(--thry-border-width);
    border-right-color: #494949;
    overflow: hidden;
}

.thry-texture-mixed-icon {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: #454b52;
}

.thry-light .thry-texture-mixed-icon {
    background-color: #bbc4ce;
}

.thry-texture-preview > .thry-texture-mixed-icon {
    border-radius: var(--thry-radius-control);
}

.thry-texture-mixed-dash {
    width: 10px;
    height: 2px;
    flex-shrink: 0;
    border-radius: 1px;
    background-color: var(--thry-value-color);
    opacity: 0.75;
}

.thry-texture-preview .thry-texture-mixed-dash {
    width: 16px;
}

.thry-asset-size {
    flex-shrink: 0;
    margin: 0 var(--thry-space-6);
    padding: 0;
    font-size: var(--thry-type-caption);
    color: #969696;
    -unity-text-align: middle-right;
}

.thry-texture-asset .unity-object-field-display__label {
    flex-grow: 1;
    color: var(--thry-value-color);
}

.thry-asset-tile > .unity-image {
    width: 23px;
    height: 20px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}

.thry-texture-asset .thry-asset-clear {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
    margin: 0 var(--thry-space-2) 0 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--thry-radius-compact);
    align-items: center;
    justify-content: center;
}

.thry-texture-asset:hover .thry-asset-tile {
    background-color: #414141;
}

.thry-light .thry-asset-tile {
    background-color: var(--thry-caption-color);
    border-right-color: #aaaaaa;
}

.thry-material-controls .unity-object-field__selector {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 22px;
    min-width: 22px;
    height: 20px;
    min-height: 20px;
    flex-shrink: 0;
    align-self: center;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-top-right-radius: var(--thry-radius-compact);
    border-bottom-right-radius: var(--thry-radius-compact);
}

.thry-texture-asset .unity-object-field__selector {
    border-radius: 0;
    background-color: transparent;
    -unity-background-image-tint-color: var(--thry-value-color);
}

/* Channel inspection stays inside the same compact texture card. */
.thry-texture-card {
    margin: -6px -6px 0;
}

.thry-texture-card .thry-texture-preview {
    margin-right: var(--thry-space-2);
}

.thry-texture-card-empty .thry-texture-preview {
    width: 40px;
    height: 40px;
}

.thry-texture-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.thry-texture-placeholder {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: #a0a0a0;
    font-size: var(--thry-type-caption);
    white-space: normal;
}

.thry-texture-summary .thry-texture-preview {
    border-width: var(--thry-border-width);
    border-color: #494949;
}

.thry-texture-summary .thry-texture-preview:hover, .thry-texture-summary .thry-texture-preview:focus {
    border-color: var(--thry-focus-color);
}

.thry-texture-channels {
    flex-direction: row;
    align-items: center;
    margin-top: var(--thry-space-4);
}

.thry-texture-summary .thry-texture-channels Button {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    align-self: center;
    width: 24px;
    min-width: 24px;
    height: var(--thry-control-height);
    min-height: var(--thry-control-height);
    margin: 0 var(--thry-space-3) 0 0;
    padding: 0;
    border-radius: var(--thry-radius-compact);
    border-width: var(--thry-border-width);
    font-size: var(--thry-type-caption);
    -unity-text-align: middle-center;
}

.thry-texture-summary .thry-texture-channels #texture-channel-RGB {
    width: 36px;
    min-width: 36px;
}

.thry-texture-summary .thry-texture-drag {
    background-color: #435563;
    border-color: var(--thry-focus-color);
}

.thry-light .thry-texture-placeholder {
    color: #606060;
}

.thry-texture-title {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.thry-texture-title .thry-texture-name {
    flex-shrink: 1;
    min-width: 0;
}

.thry-texture-summary .thry-texture-clear {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
    align-self: center;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0 var(--thry-space-2) 0 0;
    border-width: 0;
    border-radius: var(--thry-radius-compact);
}

.thry-texture-clear-icon {
    width: 14px;
    height: 14px;
    --unity-image-tint-color: #999999;
}

.thry-texture-clear:hover .thry-texture-clear-icon, .thry-texture-clear:focus .thry-texture-clear-icon {
    --unity-image-tint-color: #dddddd;
}

.thry-light .thry-texture-clear-icon {
    --unity-image-tint-color: #606060;
}

/* Texture assignment and its inline strength/reference share one value row. */
.thry-texture-value {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.thry-texture-value > .thry-texture-asset {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.thry-texture-has-reference > .thry-texture-asset {
    min-width: 76px;
}

.thry-texture-value > .thry-texture-reference {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 92px;
    margin-left: var(--thry-space-6);
}

.thry-texture-reference > .thry-property-row {
    min-height: var(--thry-control-height);
    margin-top: 0;
    margin-bottom: 0;
}

.thry-texture-value-compact > .thry-texture-reference {
    min-width: 80px;
}

.thry-texture-value-compact > .thry-texture-reference.thry-animated {
    min-width: 100px;
}

.thry-texture-value-compact .thry-asset-size {
    width: 0;
    min-width: 0;
    max-width: 0;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    overflow: hidden;
}

.thry-texture-value-compact .unity-object-field-display__label {
    margin-left: var(--thry-space-3);
}

.thry-texture-value-compact .thry-texture-reference .unity-base-slider .unity-base-text-field {
    width: 44px;
    margin-left: var(--thry-space-4);
}

/* Default-state markers match their captions without changing the text weight. */
.thry-section-title, .thry-property-label, .thry-texture-caption {
    -unity-font-style: normal;
}

.thry-caption-has-changed-indicator {
    padding-right: var(--thry-space-10);
}

.thry-property-changed-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: var(--thry-radius-compact);
}

.thry-preset-indicator {
    color: var(--thry-preset-color);
    -unity-font-style: bold;
    width: 20px;
    min-width: 20px;
    flex-shrink: 0;
    align-self: center;
    margin-right: var(--thry-space-4);
}

.thry-preset-indicator.thry-preset-animation-only {
    color: var(--thry-preset-animation-color);
}

/* Native popup/object captions have their own foreground styles; background-only
   light overrides cannot rely on inherited text color from the field container. */
.thry-light .unity-base-popup-field__text,
.thry-light .unity-object-field-display__label {
    color: #292929;
}

.thry-light .unity-base-popup-field__arrow,
.thry-light .unity-base-dropdown__arrow {
    -unity-background-image-tint-color: #555555;
}

.thry-light .thry-texture-description,
.thry-light .thry-asset-size {
    color: #606060;
}

.thry-light .unity-disabled .unity-base-popup-field__text,
.thry-light .unity-disabled .unity-object-field-display__label {
    color: #696969;
}

/* Light theme contrast and interaction states. */
.thry-menu-item .thry-menu-label {
    flex-grow: 1;
    flex-shrink: 1;
}

.thry-menu-item .thry-menu-arrow {
    width: 12px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: var(--thry-space-6);
    -unity-text-align: middle-right;
    opacity: .7;
}

.thry-light .thry-text-button:hover, .thry-light .thry-text-button:focus {
    color: #326f9c;
}

.thry-light .thry-changed-filter:hover {
    background-color: #eeeeee;
}

.thry-light .thry-changed-filter:focus {
    border-color: var(--thry-accent-color);
}

.thry-light .thry-material-controls .unity-base-text-field__input:focus, .thry-light .thry-material-controls .unity-base-popup-field__input:focus {
    border-color: var(--thry-accent-color);
}

.thry-light .thry-component > .unity-base-field__label {
    color: #5b5b5b;
}

.thry-light .thry-header-action, .thry-light .thry-fold-arrow {
    color: #5d5d5d;
}

.thry-light .thry-excluded, .thry-light .thry-excluded .thry-section-title {
    color: #5b5b5b;
}

.thry-light .thry-footer-credit, .thry-light .thry-note, .thry-light .thry-muted, .thry-light .thry-asset-size {
    color: #5b5b5b;
}

.thry-light .thry-recording > .thry-property-row > .thry-property-value {
    border-left-color: #c2185b;
}

.thry-light #thry-separator {
    background-color: #b0b0b0;
}

.thry-light .thry-ramp {
    background-color: #b8b8b8;
}

.thry-light .thry-switch-knob {
    background-color: #5d5d5d;
}

.thry-light .thry-menu-separator {
    background-color: var(--thry-border-color);
}

.thry-light .thry-texture-summary {
    border-bottom-color: #b0b0b0;
}

.thry-light .thry-texture-summary .thry-texture-preview {
    background-color: #b8b8b8;
    border-color: #aaaaaa;
}

.thry-light .thry-texture-summary .thry-texture-preview:hover, .thry-light .thry-texture-summary .thry-texture-preview:focus {
    border-color: var(--thry-accent-color);
}

.thry-light .thry-texture-summary .thry-texture-drag {
    background-color: #bfd1df;
    border-color: var(--thry-accent-color);
}

.thry-light .thry-texture-clear:hover .thry-texture-clear-icon, .thry-light .thry-texture-clear:focus .thry-texture-clear-icon {
    --unity-image-tint-color: #252525;
}

.thry-light .thry-texture-asset:hover .thry-asset-tile {
    background-color: var(--thry-border-color);
}

.thry-light .thry-studio-source {
    background-color: #c5c5c5;
}

.thry-light .thry-studio-source > .thry-studio-section > .unity-foldout__toggle {
    color: #555555;
}

/* Keep component interaction states after the general window button rules. */
/* Explicit text colors prevent native controls from inheriting dim editor defaults. */
.thry-texture-caption {
    color: var(--thry-caption-color);
}

.thry-material-controls .unity-base-text-field__input,
.thry-material-controls .unity-base-popup-field__input,
.thry-material-controls .unity-object-field__input {
    color: var(--thry-value-color);
}

/* ===== ThrySearch ===== */
.thry-property-search-results {
    margin: var(--thry-space-4) var(--thry-space-3) 0 var(--thry-space-3);
    padding: 0;
}

.thry-filtering .thry-utility {
    display: none;
}

.thry-filter-toolbar {
    flex-direction: row;
    align-items: center;
    margin: 0 0 var(--thry-space-3) 0;
}

.thry-search-summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    color: #aaa;
    font-size: var(--thry-type-body-small);
    margin: 0;
}

.thry-filter-toolbar > Button {
    background-image: none;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
    min-height: var(--thry-button-height);
    padding: var(--thry-space-2) var(--thry-space-8);
    margin: 0 0 0 var(--thry-space-8);
    font-size: var(--thry-type-body-small);
}

.thry-filter-toolbar > Button {
    flex-shrink: 0;
}

.thry-search-matches {
    margin: 0;
    padding: 0;
}

.thry-filter-group {
    margin: 0 0 var(--thry-space-3) 0;
}

.thry-filter-breadcrumb {
    white-space: normal;
    -unity-font-style: bold;
    font-size: var(--thry-type-body-small);
    color: #b8b8b8;
    margin: 0 0 var(--thry-space-4) 0;
    padding: var(--thry-space-5) var(--thry-space-4);
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: var(--thry-border-color);
}

.thry-filter-control {
    margin: 0;
    padding: 0;
}

.thry-search-hint {
    white-space: normal;
    color: #aaa;
    font-size: var(--thry-type-body-small);
    padding: var(--thry-space-8) 0;
}

.thry-light .thry-search-summary, .thry-light .thry-search-hint {
    color: #555;
}

.thry-light .thry-filter-breadcrumb {
    color: #444;
    border-bottom-color: #aaa;
}

.thry-status-filter {
    width: 120px;
    min-width: 80px;
    flex-shrink: 1;
    margin: 0;
}

.thry-status-filter > .unity-base-field__input {
    margin: 0;
    padding-left: var(--thry-space-8);
    background-color: #444;
    border-width: var(--thry-border-width);
    border-color: #555;
    border-radius: var(--thry-radius-compact);
}

.thry-saved-filters {
    width: 23px;
    min-width: 23px;
    padding: 0;
    margin: 0 0 0 var(--thry-space-3);
    font-size: var(--thry-type-heading);
    border-width: 0;
}

.thry-compact .thry-status-filter {
    width: 108px;
}

.thry-light .thry-status-filter > .unity-base-field__input {
    background-color: #ddd;
    border-color: #aaa;
}

.thry-status-filter {
    height: var(--thry-toolbar-height);
    margin-left: var(--thry-space-3);
}

.thry-status-filter > .unity-base-field__input {
    height: var(--thry-toolbar-height);
    min-height: var(--thry-toolbar-height);
}

.thry-status-filter .unity-base-popup-field__text {
    font-size: var(--thry-type-body-small);
    color: #d4d4d4;
}

.thry-saved-filters {
    height: var(--thry-toolbar-height);
}

.thry-compact .thry-status-filter {
    flex-grow: 1;
}

.thry-light .thry-status-filter .unity-base-popup-field__text {
    color: #454545;
}

.thry-light .thry-saved-filters {
    color: #454545;
}

/* Light theme contrast and interaction states. */
/* ===== ThryControlPolish ===== */
/* Compact property feedback; hierarchy arrows remain quiet icon controls. */
/* Standalone subheader bars keep nested contents flush on the right. */
.thry-subsection-panel, .thry-positioning-panel {
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    overflow: hidden;
}

.thry-subsection-panel > .thry-section-header, .thry-positioning-panel > .thry-section-header {
    border-radius: var(--thry-radius-subheader);
    background-color: var(--thry-subsection-background);
    border-color: var(--thry-subsection-background);
}

.thry-subsection-panel > .thry-section-content {
    padding-right: 0;
}

.thry-positioning-panel {
    margin: var(--thry-space-3) 0 var(--thry-space-7);
}

.thry-positioning-panel > .thry-section-content {
    padding: var(--thry-space-5) 0 var(--thry-space-5) var(--thry-space-5);
}

.thry-positioning-tools {
    margin: 0 0 var(--thry-space-5);
    padding-bottom: var(--thry-space-4);
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: #494949;
}

.thry-positioning-actions, .thry-normal-map-actions {
    flex-direction: row;
}

.thry-positioning-actions > .thry-positioning-button,
.thry-normal-map-actions > .thry-normal-map-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 25px;
    margin: 0;
    padding: 0 var(--thry-space-5);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
}

.thry-positioning-actions > .thry-positioning-secondary,
.thry-normal-map-actions > .thry-normal-map-secondary {
    margin-left: var(--thry-space-3);
}

.thry-positioning-button > Label {
    margin: 0;
    font-size: var(--thry-type-body-small);
}

.thry-positioning-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-right: var(--thry-space-6);
    color: var(--thry-monokai-green);
}

.thry-positioning-status {
    margin: var(--thry-space-4) var(--thry-space-1) 0;
    white-space: normal;
    font-size: var(--thry-type-small);
    color: #aaaaaa;
}

.thry-light .thry-subsection-panel > .thry-section-header, .thry-light .thry-positioning-panel > .thry-section-header {
    background-color: var(--thry-subsection-background);
    border-color: var(--thry-subsection-background);
}

.thry-light .thry-positioning-tools {
    border-bottom-color: #acacac;
}

.thry-light .thry-positioning-icon {
    color: var(--thry-monokai-green);
}

.thry-light .thry-positioning-status {
    color: #555555;
}

.thry-tools > .thry-collapse-tool {
    align-items: center;
    justify-content: center;
    color: var(--thry-monokai-green);
}

.thry-tools > .thry-language-tool {
    align-items: center;
    justify-content: center;
    color: var(--thry-monokai-orange);
}

.thry-light .thry-tools > .thry-collapse-tool {
    color: var(--thry-monokai-green);
}

.thry-light .thry-tools > .thry-language-tool {
    color: var(--thry-monokai-orange);
}

.thry-inspector .thry-property-row.thry-row-alt {
    border-radius: var(--thry-radius-compact);
}

.thry-light .thry-property-row.thry-row-alt {
    background-color: rgba(0, 0, 0, 0.025);
}

.thry-inspector .thry-property-row:hover {
    border-radius: var(--thry-radius-compact);
}

.thry-light .thry-property-row:hover {
    background-color: rgba(0, 0, 0, 0.045);
}

.thry-material-controls .unity-base-text-field__input:focus,
.thry-material-controls .unity-base-popup-field__input:focus,
.thry-window .unity-base-text-field__input:focus,
.thry-window .unity-base-popup-field__input:focus {
    border-color: var(--thry-focus-color);
}

.thry-light .unity-base-text-field__input:focus,
.thry-light .unity-base-popup-field__input:focus {
    border-color: #326f9c;
}

/* Axis captions occupy equal slots. Custom component captions keep their width. */
.thry-components {
    align-items: center;
    flex-wrap: nowrap;
}

.thry-components > .thry-component {
    align-items: center;
}

.thry-components > .thry-component-spaced {
    margin-left: var(--thry-space-4);
}

.thry-components > .thry-component-axis > .unity-base-field__label {
    width: 12px;
    min-width: 12px;
    max-width: 12px;
    flex-shrink: 0;
    margin-right: var(--thry-space-2);
    -unity-text-align: middle-center;
}

.thry-component > .unity-base-text-field__input {
    min-width: 0;
    padding-left: var(--thry-space-4);
    padding-right: var(--thry-space-3);
}

/* The texture row and its revealed controls form one continuous disclosure. */
.thry-texture-property.thry-texture-expanded {
    background-color: var(--thry-panel-background);
    border-radius: var(--thry-radius-control);
}

.thry-texture-expanded > .thry-texture-heading-row {
    margin-bottom: 0;
}

.thry-texture-expanded > .thry-texture-details {
    background-color: transparent;
    margin: 0 0 var(--thry-space-3) var(--thry-space-7);
    padding: var(--thry-space-2) var(--thry-space-3) var(--thry-space-4) var(--thry-space-6);
    border-radius: 0;
    border-left-width: var(--thry-border-width);
    border-left-color: #555555;
}

.thry-texture-details > .thry-texture-card {
    margin: 0;
}

.thry-texture-card .thry-texture-name {
    -unity-font-style: normal;
}

.thry-light .thry-texture-property.thry-texture-expanded {
    background-color: var(--thry-panel-background);
}

.thry-light .thry-texture-expanded > .thry-texture-details {
    background-color: transparent;
    border-left-color: #a0a0a0;
}

/* Assigned cards use a fixed-height summary; only horizontal preview area grows. */
.thry-texture-card .thry-texture-summary {
    padding-bottom: 0;
    margin-bottom: var(--thry-space-2);
}

.thry-texture-card-with-inputs .thry-texture-summary {
    border-bottom-width: 0;
}

.thry-texture-card-assigned .thry-texture-summary {
    height: 68px;
    min-height: 68px;
    max-height: 68px;
}

.thry-texture-card .thry-texture-preview {
    align-self: flex-start;
}

.thry-texture-card .thry-texture-info {
    min-width: 0;
    overflow: hidden;
}

.thry-texture-card .thry-texture-name,
.thry-texture-card .thry-texture-description {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-texture-card .thry-texture-description {
    margin: 0 var(--thry-space-2);
    font-size: var(--thry-type-small);
}

.thry-texture-card .thry-texture-channels {
    margin-top: var(--thry-space-2);
    flex-wrap: nowrap;
    min-width: 0;
}

.thry-texture-card .thry-texture-channels Button {
    flex-shrink: 1;
    min-width: 18px;
    margin-right: var(--thry-space-2);
}

.thry-texture-card .thry-texture-channels #texture-channel-RGB {
    min-width: 28px;
}

.thry-texture-card .thry-texture-channels #texture-channel-RGBA {
    width: 40px;
    min-width: 36px;
}

.thry-texture-card-compact .thry-texture-channels Button {
    width: 22px;
    height: 20px;
    min-height: 20px;
}

.thry-texture-card-compact .thry-texture-channels #texture-channel-RGB {
    width: 30px;
}

.thry-texture-card .thry-texture-channels .thry-texture-gradient-action {
    width: 62px;
    min-width: 58px;
    flex-shrink: 0;
    margin-left: var(--thry-space-4);
    padding: 0 var(--thry-space-4);
    font-size: var(--thry-type-small);
}

/* Dim the entire disabled control, including custom drawers and texture thumbnails.
   Apply the fade once so nested fields remain readable. */
.thry-inspector .thry-material-controls .unity-disabled {
    opacity: 0.5;
}

.thry-inspector .thry-material-controls .unity-disabled .unity-disabled {
    opacity: 1;
}

/* Texture foldouts remain interactive even when their assignment is locked. */
.thry-inspector .thry-material-controls .thry-readonly-texture-foldout {
    opacity: 0.5;
}

.thry-inspector .thry-material-controls .thry-readonly-texture-foldout .thry-texture-caption {
    color: #969696;
}

.thry-inspector.thry-light .thry-material-controls .thry-readonly-texture-foldout .thry-texture-caption {
    color: #696969;
}

.thry-inspector .thry-material-controls .unity-disabled .thry-readonly-texture-foldout {
    opacity: 1;
}

.thry-material-controls .unity-disabled .thry-property-label,
.thry-material-controls .unity-disabled .thry-texture-caption,
.thry-material-controls .unity-disabled .unity-base-field__label,
.thry-material-controls .unity-disabled .unity-object-field-display__label {
    color: #969696;
}

.thry-material-controls .unity-disabled .unity-base-text-field__input,
.thry-material-controls .unity-disabled .unity-base-popup-field__input,
.thry-material-controls .unity-disabled .unity-object-field__input {
    color: #969696;
    background-color: #323232;
    border-color: #434343;
}

.thry-light .thry-material-controls .unity-disabled .thry-property-label,
.thry-light .thry-material-controls .unity-disabled .thry-texture-caption,
.thry-light .thry-material-controls .unity-disabled .unity-base-field__label,
.thry-light .thry-material-controls .unity-disabled .unity-object-field-display__label {
    color: #696969;
}

.thry-light .thry-material-controls .unity-disabled .unity-base-text-field__input,
.thry-light .thry-material-controls .unity-disabled .unity-base-popup-field__input,
.thry-light .thry-material-controls .unity-disabled .unity-object-field__input {
    color: #696969;
    background-color: #b9b9b9;
    border-color: #a6a6a6;
}

/* ===== ThryAuxiliary ===== */
/* Window-only refinements; these never change the embedded material inspector. */
.thry-light.thry-window .thry-search Button,
.thry-light.thry-window .thry-search Button:hover,
.thry-light.thry-window .thry-search Button:active {
    -unity-background-image-tint-color: #555555;
}

.thry-settings .unity-foldout {
    margin: var(--thry-space-2) 0;
}

.thry-settings .unity-foldout__content {
    padding-top: var(--thry-space-2);
    padding-bottom: var(--thry-space-2);
}

.thry-texture-workspace .thry-studio-section {
    margin: var(--thry-space-2) 0;
}

.thry-texture-workspace .thry-studio-source {
    margin: var(--thry-space-2) 0;
    padding: var(--thry-space-4) var(--thry-space-6);
}

.thry-texture-workspace .thry-studio-source .thry-studio-section {
    margin: 0;
}

.thry-texture-workspace .thry-studio-hint {
    white-space: normal;
    color: #b4b4b4;
    font-size: var(--thry-type-small);
    margin: var(--thry-space-4) var(--thry-space-2) var(--thry-space-8);
}

.thry-light.thry-texture-workspace .thry-studio-hint, .thry-light.thry-texture-workspace .thry-muted {
    color: #505050;
}

.thry-lock-manager .thry-lock-material-name {
    min-width: 0;
    flex-basis: 0;
    flex-shrink: 1;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-cross-materials {
    margin: var(--thry-space-2) 0;
    padding: var(--thry-space-2) var(--thry-space-4);
    background-color: #3d3d3d;
    border-radius: var(--thry-radius-panel-small);
}

.thry-cross-materials > .unity-foldout__toggle {
    min-height: var(--thry-button-height);
    margin: 0;
    -unity-font-style: bold;
}

.thry-cross-materials .thry-components {
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    min-height: var(--thry-button-height);
    margin: var(--thry-space-1) 0;
}

.thry-cross-materials .unity-object-field {
    min-width: 0;
    flex-basis: 0;
    flex-shrink: 1;
}

.thry-cross-materials .unity-object-field__input {
    min-height: var(--thry-control-height);
    padding: 0 var(--thry-space-6);
    border-width: var(--thry-border-width);
    border-color: #494949;
    background-color: #2c2c2c;
    border-radius: var(--thry-radius-panel-small);
}

.thry-cross-materials Button {
    height: var(--thry-button-height);
    margin: 0 var(--thry-space-2);
    padding: 0 var(--thry-space-8);
    border-radius: var(--thry-radius-button);
    border-width: var(--thry-border-width);
}

.thry-cross-materials .unity-toggle__input {
    align-items: center;
}

.thry-cross-materials .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    margin: 0;
    border-radius: var(--thry-radius-compact);
    background-color: #2c2c2c;
    border-color: #535353;
    border-width: var(--thry-border-width);
}

.thry-cross-materials .unity-foldout__toggle .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
}

.thry-light .thry-cross-materials {
    background-color: #c4c4c4;
}

.thry-light .thry-cross-materials .unity-object-field__input, .thry-light .thry-cross-materials .unity-toggle__checkmark {
    background-color: #e4e4e4;
    border-color: #aaaaaa;
}

.thry-light .thry-cross-materials .unity-foldout__toggle .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
}

/* Dialog controls share the same fields, focus cues and compact action rows. */
.thry-window .unity-object-field__input {
    min-height: var(--thry-control-height);
    padding: 0 var(--thry-space-6);
    border-width: var(--thry-border-width);
    border-color: #494949;
    border-radius: var(--thry-radius-control);
    background-color: #2c2c2c;
}

.thry-window .unity-base-field:focus > .unity-base-field__input {
    border-color: var(--thry-focus-color);
}

.thry-window .unity-toggle:focus .unity-toggle__checkmark {
    border-color: var(--thry-control-border-color);
}

.thry-dialog .unity-toggle__input {
    align-items: center;
}

.thry-dialog .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    margin: 0;
    border-radius: var(--thry-radius-compact);
    background-color: #2c2c2c;
    border-color: #535353;
    border-width: var(--thry-border-width);
}

.thry-dialog .unity-foldout__toggle .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
}

.thry-dialog .unity-foldout {
    margin: var(--thry-space-2) 0;
}

.thry-dialog .unity-base-field {
    margin-top: var(--thry-space-2);
    margin-bottom: var(--thry-space-2);
}

.thry-dialog .thry-title {
    margin-bottom: var(--thry-space-4);
}

.thry-dialog-actions {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: var(--thry-space-4);
}

.thry-dialog-actions > Button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 var(--thry-space-1);
    height: var(--thry-toolbar-height);
    min-height: var(--thry-toolbar-height);
}

.thry-dialog .thry-primary-action {
    -unity-font-style: bold;
}

.thry-gradient-editor .thry-gradient-preview {
    height: 64px;
    min-height: 64px;
    margin-bottom: var(--thry-space-4);
}

.thry-gradient-editor > .unity-base-field > .unity-base-field__label {
    min-width: 100px;
    width: 38%;
    max-width: 170px;
}

.thry-gradient-editor .unity-base-compound-field > .unity-base-field__input {
    min-width: 0;
}

.thry-light.thry-window .unity-object-field__input, .thry-light.thry-dialog .unity-toggle__checkmark {
    background-color: #e4e4e4;
    border-color: #aaaaaa;
}

.thry-light.thry-dialog .unity-foldout__toggle .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
}

.thry-light.thry-window .unity-base-field:focus > .unity-base-field__input,
.thry-light.thry-window .unity-toggle:focus .unity-toggle__checkmark {
    border-color: var(--thry-control-border-color);
}

.thry-window .unity-foldout {
    margin-top: var(--thry-row-gap);
    margin-bottom: var(--thry-row-gap);
}

.thry-window .unity-foldout__toggle, .thry-cross-materials > .unity-foldout__toggle {
    min-height: var(--thry-section-height);
    -unity-font-style: normal;
    font-size: var(--thry-font-size);
}

.thry-window .unity-base-field, .thry-window Button, .thry-settings .thry-property-label {
    font-size: var(--thry-font-size);
}

.thry-window .unity-base-compound-field__input {
    min-width: 0;
}

.thry-window .unity-base-compound-field__field {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    margin-left: var(--thry-space-2);
}

.thry-window .unity-base-compound-field__field > .unity-base-field__label {
    width: 12px;
    min-width: 12px;
    max-width: 12px;
    margin-right: var(--thry-space-2);
    padding: 0;
    -unity-text-align: middle-center;
}

.thry-window .unity-foldout__toggle:focus {
    background-color: #4b5359;
}

.thry-light.thry-window .unity-foldout__toggle:focus {
    background-color: #bed0dc;
}

.thry-menu-back {
    height: var(--thry-menu-item-height);
    margin: 0;
    border-width: 0;
    background-color: transparent;
    -unity-text-align: middle-left;
}

/* Light theme contrast and interaction states. */
/* Preset browsing keeps the library, staged choices and final action distinct. */
.thry-preset-browser {
    padding: var(--thry-space-10);
    min-width: 0;
}

.thry-preset-browser-header {
    margin-bottom: var(--thry-space-8);
    flex-shrink: 0;
}

.thry-preset-browser-header .thry-title {
    font-size: var(--thry-type-title);
    -unity-font-style: normal;
    margin: 0 0 var(--thry-space-3);
}

.thry-preset-muted, .thry-preset-path {
    color: #a0a0a0;
    font-size: var(--thry-type-small);
    white-space: normal;
}

.thry-preset-browser-search {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--thry-space-8);
    flex-shrink: 0;
    min-height: var(--thry-window-control-height);
}

.thry-preset-browser-search .thry-search {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: var(--thry-window-control-height);
    margin: 0;
}

.thry-preset-browser .thry-search Button {
    border-width: 0;
}

.thry-light.thry-preset-browser .thry-search Button {
    -unity-background-image-tint-color: #555555;
}

.thry-preset-browser-search #preset-category {
    width: 150px;
    min-width: 110px;
    flex-shrink: 1;
    margin: 0 0 0 var(--thry-space-6);
    height: var(--thry-window-control-height);
}

.thry-preset-browser-body {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.thry-preset-browser-library, .thry-preset-browser-details {
    background-color: #303030;
    border-width: var(--thry-border-width);
    border-color: #484848;
    border-radius: var(--thry-radius-panel);
    padding: var(--thry-space-6);
    min-width: 0;
    min-height: 0;
}

.thry-preset-browser-details {
    margin-left: var(--thry-space-8);
}

.thry-preset-stacked .thry-preset-browser-details {
    margin-left: 0;
    margin-top: var(--thry-space-6);
}

.thry-preset-browser-list {
    margin-top: var(--thry-space-4);
    min-height: 0;
}

.thry-preset-browser .thry-preset-category {
    margin: 0 0 var(--thry-space-2);
}

.thry-preset-browser .thry-preset-category > .unity-foldout__toggle {
    min-height: var(--thry-button-height);
    margin: 0;
    padding: var(--thry-space-1) var(--thry-space-3);
    border-radius: var(--thry-radius-compact);
    background-color: transparent;
    color: #bcbcbc;
    font-size: var(--thry-type-body-small);
    -unity-font-style: normal;
    border-color: transparent;
}

.thry-preset-browser .thry-preset-category > .unity-foldout__toggle:hover {
    background-color: #3b3b3b;
    border-color: #3b3b3b;
}

.thry-preset-browser .thry-preset-category > .unity-foldout__content {
    margin: 0 0 0 var(--thry-space-12);
    padding: 0 0 0 var(--thry-space-2);
    border-left-width: var(--thry-border-width);
    border-left-color: #414141;
}

.thry-preset-browser-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--thry-toolbar-height);
    padding: var(--thry-space-2) var(--thry-space-5);
    margin: 0 0 var(--thry-space-2);
    border-radius: var(--thry-radius-compact);
    border-left-width: var(--thry-border-width-strong);
    border-left-color: transparent;
}

.thry-preset-browser-row:hover {
    background-color: #3b3b3b;
}

.thry-preset-browser-row.thry-preset-row-selected {
    background-color: #34434e;
    border-left-color: #769bb6;
}

.thry-preset-browser .thry-preset-caption {
    color: #d0d0d0;
    font-size: var(--thry-type-body-small);
    -unity-font-style: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-preset-browser .thry-preset-path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: var(--thry-space-2);
}

.thry-preset-browser-row .unity-toggle {
    flex-shrink: 0;
    margin: 0 var(--thry-space-6) 0 0;
    padding: 0;
}

.thry-preset-browser-row .unity-toggle__input {
    align-items: center;
}

.thry-preset-browser-row .unity-toggle__checkmark {
    width: 15px;
    height: 15px;
    min-width: 15px;
    margin: 0;
    border-width: var(--thry-border-width);
    border-color: #777;
    background-color: #282828;
    border-radius: var(--thry-radius-compact);
}

.thry-preset-browser-row > .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    width: 16px;
    min-width: 16px;
    margin-right: var(--thry-space-6);
}

.thry-preset-row-caption {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.thry-preset-checkmark {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: var(--thry-type-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #333;
}

.thry-light.thry-preset-browser .thry-preset-row-selected .thry-preset-checkmark {
    display: flex;
}

.thry-preset-selection-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: var(--thry-button-height);
    margin-bottom: var(--thry-space-4);
    flex-shrink: 0;
}

.thry-preset-subtitle {
    color: #ccc;
    font-size: var(--thry-type-body-small);
    -unity-font-style: normal;
    margin: var(--thry-space-3) 0 var(--thry-space-5);
}

.thry-preset-selected-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--thry-toolbar-height);
    margin: 0 0 var(--thry-space-3);
    padding: var(--thry-space-2) var(--thry-space-3);
    background-color: #3a3a3a;
    border-radius: var(--thry-radius-compact);
}

.thry-preset-selected-row > .thry-preset-caption {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.thry-preset-order {
    width: 20px;
    min-width: 20px;
    flex-shrink: 0;
    margin-right: var(--thry-space-3);
    color: #a6bdcc;
    font-size: var(--thry-type-small);
    -unity-text-align: middle-center;
}

.thry-preset-browser .thry-preset-small-action {
    height: var(--thry-control-height);
    min-height: var(--thry-control-height);
    min-width: 22px;
    margin: 0 0 0 var(--thry-space-3);
    padding: 0 var(--thry-space-4);
    font-size: var(--thry-type-small);
}

.thry-preset-changes {
    margin-top: var(--thry-space-6);
    padding-top: var(--thry-space-6);
    border-top-width: var(--thry-border-width);
    border-top-color: #484848;
    min-height: 0;
}

.thry-preset-change-row {
    padding: var(--thry-space-3) 0;
    margin-bottom: var(--thry-space-3);
    white-space: normal;
    font-size: var(--thry-type-small);
    color: #bcbcbc;
}

.thry-preset-summary {
    color: #aaa;
    font-size: var(--thry-type-small);
    margin: 0 var(--thry-space-8) 0 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

.thry-preset-browser-footer {
    flex-direction: row;
    align-items: center;
    margin-top: var(--thry-space-8);
    min-height: 30px;
    flex-shrink: 0;
}

.thry-preset-browser-footer > Button {
    height: var(--thry-window-control-height);
    min-height: var(--thry-window-control-height);
    padding: 0 var(--thry-space-12);
    margin: 0 0 0 var(--thry-space-6);
    flex-shrink: 0;
}

.thry-preset-browser #preset-apply {
    -unity-font-style: normal;
}

.thry-light.thry-preset-browser .thry-preset-browser-library, .thry-light.thry-preset-browser .thry-preset-browser-details {
    background-color: #d0d0d0;
    border-color: #ababab;
}

.thry-light.thry-preset-browser .thry-preset-caption {
    color: #292929;
}

.thry-light.thry-preset-browser .thry-preset-category > .unity-foldout__toggle {
    color: #444;
}

.thry-light.thry-preset-browser .thry-preset-category > .unity-foldout__toggle:hover {
    background-color: var(--thry-surface-color);
    border-color: var(--thry-surface-color);
}

.thry-light.thry-preset-browser .thry-preset-category > .unity-foldout__content {
    border-left-color: #b7b7b7;
}

.thry-light.thry-preset-browser .thry-preset-subtitle {
    color: #333;
}

.thry-light.thry-preset-browser .thry-preset-browser-row .unity-toggle__checkmark {
    background-image: none;
    background-color: #f0f0f0;
    border-color: #888;
}

.thry-light.thry-preset-browser .thry-preset-category > .unity-foldout__toggle .unity-foldout__checkmark {
    -unity-background-image-tint-color: #555;
}

.thry-light.thry-preset-browser .unity-scroller {
    background-color: transparent;
    border-width: 0;
}

.thry-light.thry-preset-browser .unity-scroller .unity-base-slider__input {
    background-color: transparent;
}

.thry-light.thry-preset-browser .unity-scroller .unity-base-slider__dragger {
    background-color: #999;
    border-color: #888;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-round);
}

.thry-light.thry-preset-browser .unity-scroller .unity-base-slider__dragger:hover {
    background-color: #858585;
}

.thry-light.thry-preset-browser .unity-scroller__low-button,
.thry-light.thry-preset-browser .unity-scroller__high-button {
    background-color: transparent;
    border-width: 0;
    -unity-background-image-tint-color: #555;
}

.thry-light.thry-preset-browser .thry-preset-muted, .thry-light.thry-preset-browser .thry-preset-path, .thry-light.thry-preset-browser .thry-preset-summary, .thry-light.thry-preset-browser .thry-preset-change-row {
    color: #555;
}

.thry-light.thry-preset-browser .thry-preset-browser-row:hover {
    background-color: var(--thry-surface-color);
}

.thry-light.thry-preset-browser .thry-preset-row-selected {
    background-color: #b8cdda;
    border-left-color: #47768f;
}

.thry-light.thry-preset-browser .thry-preset-selected-row {
    background-color: var(--thry-surface-color);
}

.thry-light.thry-preset-browser .thry-preset-order {
    color: #405e70;
}

.thry-light.thry-preset-browser .thry-preset-changes {
    border-top-color: #ababab;
}

.thry-light.thry-preset-browser .thry-preset-small-action {
    color: #444;
}

/* ===== ThrySpecialControls ===== */
.thry-special-slider-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--thry-control-height);
    margin: var(--thry-space-1) 0;
}

.thry-special-slider-row > .thry-special-component-label {
    width: 30%;
    max-width: 110px;
    min-width: 28px;
    flex-shrink: 1;
    margin-right: var(--thry-space-6);
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--thry-caption-color);
}

.thry-special-slider-row > .unity-slider {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
}

.thry-special-axis-slider {
    min-height: var(--thry-control-height);
    margin: 0 0 var(--thry-space-2);
}

.thry-special-axis-slider > .thry-special-component-label {
    width: 14px;
    min-width: 14px;
    max-width: 14px;
    flex-shrink: 0;
    margin: 0 var(--thry-space-3) 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: var(--thry-muted-color);
}

.thry-light .thry-special-axis-slider > .thry-special-component-label {
    color: #5b5b5b;
}

.thry-multi-value-controls > Button, .thry-multi-value-controls > .unity-base-field {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 var(--thry-space-2);
}

.thry-multi-value-controls > Button {
    min-height: var(--thry-button-height);
    padding: var(--thry-space-2) var(--thry-space-4);
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-multi-value-header > Label {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 var(--thry-space-2);
    padding: 0 var(--thry-space-4);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
}

.thry-multi-value-controls > .thry-tile-mixed {
    border-color: #999;
    border-bottom-width: var(--thry-border-width-strong);
}

.thry-mask-picker {
    min-height: var(--thry-button-height);
    -unity-text-align: middle-left;
    padding: var(--thry-space-2) var(--thry-space-8);
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-packer-source-row {
    margin: var(--thry-space-1) 0;
}

.thry-packer-source-value {
    flex-direction: row;
    align-items: center;
}

.thry-packer-source-value > .thry-texture-asset {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.thry-packer-source-value > .thry-packer-source-channel,
.thry-packer-source-value > .thry-packer-source-fallback {
    width: 58px;
    min-width: 58px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: var(--thry-space-3);
}

.thry-packer-source-channel .unity-base-popup-field__input {
    padding-left: var(--thry-space-5);
    padding-right: var(--thry-space-2);
}

.thry-packer-source-compact .thry-asset-size {
    display: none;
}

.thry-packer {
    margin: 0 var(--thry-space-3) var(--thry-space-3);
    padding-bottom: var(--thry-space-5);
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: #414141;
}

.thry-packer-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 var(--thry-space-3);
    min-height: var(--thry-control-height);
}

.thry-packer-heading-label {
    margin: 0;
    color: var(--thry-caption-color);
    font-size: var(--thry-type-small);
}

.thry-packer-channel-badge {
    width: 18px;
    min-width: 18px;
    height: 16px;
    flex-shrink: 0;
    margin: 0 var(--thry-space-4) 0 0;
    padding: 0;
    border-radius: var(--thry-radius-compact);
    background-color: #414141;
    color: var(--thry-caption-color);
    font-size: var(--thry-type-caption);
    -unity-text-align: middle-center;
}

.thry-packer-channel-r {
    color: var(--thry-channel-r-color);
}

.thry-packer-channel-g {
    color: var(--thry-channel-g-color);
}

.thry-packer-channel-b {
    color: var(--thry-channel-b-color);
}

.thry-packer-channel-rgb {
    width: 27px;
    min-width: 27px;
}

.thry-packer-source-row .thry-texture-caption {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.thry-packer-source-row > .thry-texture-label {
    min-height: var(--thry-control-height);
    margin: 0;
}

.thry-packer-channel-options {
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0.08);
    border-radius: var(--thry-radius-compact);
}

.thry-packer-channel-options > .unity-foldout__toggle {
    display: none;
}

.thry-packer-channel-options > .unity-foldout__content {
    margin-left: 0;
    padding: 0;
}

.thry-packer-actions {
    flex-grow: 0;
    margin-top: var(--thry-space-4);
}

.thry-packer-actions > Button,
.thry-packer-studio-action {
    background-image: none;
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
    height: var(--thry-button-height);
    min-height: var(--thry-button-height);
    padding: var(--thry-space-2) var(--thry-space-6);
    margin: 0 var(--thry-space-2);
    font-size: var(--thry-type-body-small);
    -unity-text-align: middle-center;
}

.thry-packer-actions > Button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.thry-packer-heading > .thry-packer-studio-action {
    height: 20px;
    min-height: 20px;
    margin: 0;
    padding: 0 var(--thry-space-6);
    font-size: var(--thry-type-small);
}

.thry-light .thry-packer {
    border-bottom-color: #bbb;
}

.thry-light .thry-packer-channel-badge {
    background-color: var(--thry-surface-color);
    color: #444;
}

.thry-light .thry-packer-channel-r {
    color: var(--thry-channel-r-color);
}

.thry-light .thry-packer-channel-g {
    color: var(--thry-channel-g-color);
}

.thry-light .thry-packer-channel-b {
    color: var(--thry-channel-b-color);
}

.thry-light .thry-special-slider-row > .thry-special-component-label {
    color: #444;
}

.thry-bit-options > .unity-foldout__content {
    margin-left: 0;
}

.thry-bit-row {
    flex-direction: row;
    min-width: 0;
    margin: var(--thry-space-2) 0;
}

.thry-bit-cell {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.thry-bit-cell > .unity-base-field__label {
    width: auto;
    min-width: 0;
    max-width: none;
    min-height: 14px;
    margin: 0 0 var(--thry-space-2) 0;
    padding: 0;
    font-size: var(--thry-type-caption);
    -unity-text-align: middle-center;
    align-self: center;
}

.thry-bit-cell > .unity-base-field__input {
    width: 16px;
    min-width: 16px;
    max-width: 16px;
    flex-grow: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

/* Light theme contrast and interaction states. */
.thry-light .thry-multi-value-controls > .thry-tile-mixed {
    border-color: #777777;
}

/* Uniform vector scaling is an explicit linked/independent toggle, not a symbol cycle. */
.thry-components > .thry-vector-link {
    width: 24px;
    min-width: 24px;
    max-width: 24px;
    height: var(--thry-control-height);
    min-height: var(--thry-control-height);
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 0 0 var(--thry-space-4);
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: var(--thry-border-width);
    border-color: transparent;
    border-radius: var(--thry-radius-compact);
}

.thry-vector-link > .unity-toggle__input {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

.thry-vector-link .unity-toggle__checkmark {
    display: none;
}

.thry-vector-link > .thry-vector-link-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    --unity-image-tint-color: #bcbcbc;
}

.thry-light .thry-vector-link > .thry-vector-link-icon {
    --unity-image-tint-color: #555555;
}

.thry-components > .thry-vector-link:hover {
    background-color: var(--thry-surface-color);
    border-color: var(--thry-surface-color);
}

.thry-components > .thry-vector-link:focus {
    border-color: var(--thry-focus-color);
}

.thry-components > .thry-vector-linked {
    background-color: #3c515f;
    border-color: #648ca7;
}

.thry-components > .thry-vector-linked:hover {
    background-color: #455f70;
    border-color: var(--thry-accent-color);
}

.thry-vector-components-linked > .thry-component > .unity-base-field__label {
    color: #a8d3e9;
}

.thry-light .thry-components > .thry-vector-link:hover {
    background-color: #dddddd;
    border-color: #dddddd;
}

.thry-light .thry-components > .thry-vector-linked {
    background-color: #bfd1df;
    border-color: #648ca7;
}

.thry-light .thry-components > .thry-vector-linked:hover {
    background-color: #cfe0ec;
    border-color: var(--thry-accent-color);
}

.thry-light .thry-vector-components-linked > .thry-component > .unity-base-field__label {
    color: #285e7d;
}

/* ===== ThryMultiMaterial ===== */
.thry-multi-selection {
    background-color: #3d3d3d;
    border-radius: var(--thry-radius-panel-small);
    padding: var(--thry-space-2) var(--thry-space-4);
    margin: 0 0 var(--thry-space-2);
}

.thry-multi-selection > .unity-foldout {
    margin: 0;
}

.thry-multi-selection .unity-foldout__toggle {
    min-height: var(--thry-button-height);
    margin: 0;
    -unity-font-style: bold;
}

.thry-multi-hint {
    white-space: normal;
    color: #aaaaaa;
    font-size: var(--thry-type-small);
    margin: var(--thry-space-2) 0;
}

.thry-multi-material-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: var(--thry-space-1) 0;
}

.thry-multi-material-name {
    flex-grow: 1;
    flex-basis: 40%;
    min-width: 80px;
    margin: 0;
    padding: var(--thry-space-1) var(--thry-space-4);
    min-height: var(--thry-control-height);
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
    text-overflow: ellipsis;
    overflow: hidden;
}

.thry-multi-material-name:hover {
    color: var(--thry-accent-color);
    background-color: var(--thry-surface-color);
}

.thry-multi-material-incompatible .thry-multi-material-name,
.thry-multi-material-incompatible .thry-multi-shader-name,
.thry-multi-material-incompatible .thry-multi-material-name:hover {
    color: #f26d78;
}

.thry-light .thry-multi-material-incompatible .thry-multi-material-name,
.thry-light .thry-multi-material-incompatible .thry-multi-shader-name,
.thry-light .thry-multi-material-incompatible .thry-multi-material-name:hover {
    color: #b52637;
}

.thry-multi-shader-name {
    flex-grow: 1;
    flex-basis: 55%;
    min-width: 100px;
    color: #aaaaaa;
    font-size: var(--thry-type-caption);
    margin: 0;
    text-overflow: ellipsis;
    overflow: hidden;
}

.thry-multi-badge {
    position: absolute;
    width: 16px;
    height: 16px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    color: #aeb9c0;
}

.thry-light .thry-multi-selection {
    background-color: #c4c4c4;
}

.thry-light .thry-multi-hint, .thry-light .thry-multi-shader-name {
    color: #555555;
}

.thry-light .thry-multi-badge {
    color: #53616a;
}

.thry-light .thry-multi-material-name:hover {
    color: #326f9c;
    background-color: #d6d6d6;
}

/* ===== ThryPathing ===== */
.thry-pathing {
    --thry-pathing-column-divider: #5b5b5b;
    --thry-pathing-column-alternate: rgba(255, 255, 255, .035);
    --thry-pathing-grip-color: #747474;
    --thry-pathing-grip-hover-color: #909090;
    margin: var(--thry-space-5) var(--thry-space-1) 9px;
}

.thry-light .thry-pathing {
    --thry-pathing-column-divider: #999999;
    --thry-pathing-column-alternate: rgba(0, 0, 0, .035);
    --thry-pathing-grip-color: #888888;
    --thry-pathing-grip-hover-color: #666666;
}

.pathing-row {
    flex-direction: row;
    align-items: center;
}

.pathing-eyebrow {
    font-size: var(--thry-type-caption);
    color: var(--thry-muted-color);
    -unity-font-style: bold;
    flex-grow: 1;
}

.pathing-preview {
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: var(--thry-space-6) var(--thry-space-7);
    margin-bottom: var(--thry-space-5);
}

.pathing-preview-toolbar {
    margin-bottom: var(--thry-space-8);
}

.pathing-preview-hidden .pathing-preview-toolbar {
    margin-bottom: 0;
}

.pathing-preview Button {
    margin: 0 0 0 var(--thry-space-4);
    height: var(--thry-button-height);
    font-size: var(--thry-type-small);
}

.pathing-preview .pathing-lane-label {
    width: 25px;
    min-width: 25px;
    margin: 0 var(--thry-space-7) 0 0;
    padding: 0;
    -unity-font-style: bold;
}

.pathing-lane {
    background-color: var(--thry-field-background);
    border-radius: var(--thry-radius-compact);
    overflow: hidden;
    height: var(--thry-control-height);
    flex-grow: 1;
    margin-bottom: var(--thry-space-2);
}

.pathing-preview-content > Slider {
    margin: var(--thry-space-5) 0 0 30px;
}

.pathing-help {
    color: var(--thry-muted-color);
    font-size: var(--thry-type-small);
    white-space: normal;
    margin: var(--thry-space-3) var(--thry-space-4) var(--thry-space-8);
}

.thry-pathing #pathing-sources {
    margin-bottom: var(--thry-space-8);
}

.pathing-grid {
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
    background-color: transparent;
    margin-bottom: var(--thry-space-7);
}

.pathing-grid-row {
    min-height: var(--thry-window-control-height);
    align-items: stretch;
    border-bottom-width: 0;
}

.pathing-grid-label {
    width: 18%;
    min-width: 60px;
    flex-shrink: 0;
    font-size: var(--thry-font-size);
    color: var(--thry-caption-color);
    margin: 0;
    padding: var(--thry-space-4) var(--thry-space-3) var(--thry-space-4) var(--thry-space-7);
    -unity-text-align: middle-left;
}

.pathing-cell {
    width: 20.5%;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: var(--thry-space-2) var(--thry-space-3);
    justify-content: center;
    border-left-width: 0;
}

.pathing-cell.pathing-selected {
    background-color: transparent;
}

.pathing-cell.pathing-off > * {
    opacity: .53;
}

.pathing-cell > Button {
    height: var(--thry-toolbar-height);
    min-width: 0;
    padding: 0 var(--thry-space-2);
    margin: 0;
    border-width: 0;
    -unity-font-style: bold;
    font-size: var(--thry-type-small);
}

.pathing-cell > Label {
    -unity-text-align: middle-center;
}

.pathing-cell .thry-property {
    min-width: 0;
    flex-grow: 1;
}

.pathing-cell .thry-property-row {
    min-width: 0;
    padding: 0;
    margin: 0;
}

.pathing-cell .thry-property-label {
    display: none;
}

.pathing-cell .thry-property-value {
    min-width: 0;
    margin: 0;
    padding: 0;
    flex-grow: 1;
}

.pathing-cell .thry-inline {
    min-width: 0;
    margin: 0;
    padding: 0;
}

.pathing-cell .unity-base-field {
    margin: 0;
    min-width: 0;
    flex-grow: 1;
}

.pathing-cell .unity-base-field__input {
    min-width: 0;
}

.pathing-cell .unity-base-field__label {
    display: none;
}

/* The native label is both the visible grip and the drag target. */
.pathing-cell .pathing-component .pathing-value-grip {
    display: flex;
    width: 7px;
    min-width: 7px;
    max-width: 7px;
    height: var(--thry-control-height);
    min-height: var(--thry-control-height);
    flex-shrink: 0;
    align-self: center;
    margin: 0 var(--thry-space-3) 0 0;
    padding: 0;
    border-radius: var(--thry-radius-control);
    background-color: var(--thry-pathing-grip-color);
}

.pathing-cell .thry-components {
    flex-grow: 1;
    min-width: 0;
}

.pathing-cell .thry-component {
    flex-grow: 1;
    min-width: 0;
    flex-basis: 0;
}

.pathing-cell .unity-base-popup-field__text {
    font-size: var(--thry-type-small);
    padding-left: var(--thry-space-2);
}

.pathing-cell .unity-base-popup-field__arrow {
    width: 9px;
}

.pathing-cell .unity-text-input {
    font-size: var(--thry-type-small);
}

.pathing-cell .unity-color-field__eyedropper {
    display: none;
}

.pathing-cell .unity-color-field__input {
    margin: 0;
}

.pathing-component {
    flex-grow: 1;
}

.pathing-cell .pathing-auto-label {
    color: var(--thry-muted-color);
    font-size: var(--thry-type-caption);
    -unity-text-align: middle-center;
    margin: 0;
}

.pathing-routing-note {
    font-size: var(--thry-type-caption);
    color: var(--thry-muted-color);
    margin: 0;
}

.pathing-actions {
    justify-content: space-between;
    margin: var(--thry-space-3) 0 var(--thry-space-4);
}

.pathing-actions Button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: var(--thry-type-small);
    height: var(--thry-button-height);
    padding: 0 var(--thry-space-8);
    margin: 0;
    border-radius: var(--thry-radius-button);
}

.pathing-actions > #pathing-copy {
    margin-left: var(--thry-space-5);
}

.pathing-grid-heading {
    background-color: var(--thry-subsection-background);
    border-radius: var(--thry-radius-subheader);
    border-color: var(--thry-subsection-background);
}

.pathing-property-caption {
    justify-content: center;
    overflow: hidden;
}

.pathing-property-caption > .thry-property-row {
    min-height: 20px;
    margin: 0;
}

.pathing-property-caption .thry-property-label {
    width: auto;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    padding-right: var(--thry-space-8);
    font-size: var(--thry-font-size);
}

/* Neutral surfaces and interaction states follow the same inspector roles. */
.pathing-preview Button, .pathing-actions Button {
    border-width: var(--thry-border-width);
    border-radius: var(--thry-radius-button);
}

.pathing-preview .pathing-lane-label {
    border-width: 0;
}

.pathing-grid-heading .pathing-cell {
    border-bottom-width: var(--thry-border-width-strong);
    border-bottom-color: transparent;
}

.pathing-grid-heading .pathing-cell.pathing-selected {
    background-color: var(--thry-selection-background);
    border-bottom-color: var(--thry-focus-color);
}

.pathing-grid-heading .pathing-cell > Button {
    border-radius: var(--thry-radius-button);
}

.pathing-grid-heading .pathing-cell > Button:focus {
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: var(--thry-focus-color);
}

.pathing-cell .pathing-component .pathing-value-grip:hover {
    background-color: var(--thry-pathing-grip-hover-color);
}

.thry-pathing .pathing-accent-0 {
    color: var(--thry-channel-r-color);
}

.thry-pathing .pathing-accent-1 {
    color: var(--thry-channel-g-color);
}

.thry-pathing .pathing-accent-2 {
    color: var(--thry-channel-b-color);
}

.thry-pathing .pathing-accent-3 {
    color: var(--thry-channel-a-color);
}

/* ===== ThryStencil ===== */
.thry-stencil-view {
    --thry-stencil-lit-color: var(--thry-monokai-cyan);
    padding: var(--thry-space-6);
    margin: var(--thry-space-2) 0;
    background-color: #333333;
    border-radius: var(--thry-radius-control);
    min-width: 0;
}

.thry-stencil-byte-row {
    flex-direction: row;
    align-items: center;
    margin: var(--thry-space-1) 0;
    min-height: var(--thry-button-height);
}

.thry-stencil-label {
    width: 120px;
    min-width: 80px;
    flex-shrink: 0;
    margin: 0;
    padding-right: var(--thry-space-6);
    font-size: var(--thry-type-small);
    white-space: normal;
}

.thry-stencil-values {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.thry-stencil-bits {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.thry-stencil-bit {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: var(--thry-control-height);
    min-height: var(--thry-control-height);
    margin: 0 var(--thry-space-1);
    padding: 0;
    -unity-text-align: middle-center;
    font-size: var(--thry-type-small);
    border-radius: var(--thry-radius-compact);
    background-color: #292929;
    border-color: #292929;
    border-width: var(--thry-border-width);
    color: #999999;
}

.thry-stencil-bit.thry-stencil-bit-set {
    background-color: var(--thry-stencil-lit-color);
    border-color: var(--thry-stencil-lit-color);
    color: #202020;
}

.thry-stencil-bit:hover {
    border-color: var(--thry-accent-color);
}

.thry-stencil-bit:focus {
    border-color: var(--thry-accent-color);
}

.thry-stencil-decimal {
    width: 46px;
    min-width: 46px;
    flex-shrink: 0;
    margin: 0 0 0 var(--thry-space-6);
    padding: 0;
    -unity-text-align: middle-right;
}

/* Read-only values share the input text origin: 1px border + 6px padding. */
.thry-stencil-values > Label.thry-stencil-decimal {
    height: var(--thry-control-height);
    padding-left: var(--thry-space-7);
    padding-right: var(--thry-space-7);
    -unity-text-align: middle-left;
}

.thry-stencil-weights .thry-stencil-bit {
    background-color: transparent;
    border-width: 0;
    font-size: var(--thry-type-micro);
    color: #999999;
    border-color: transparent;
}

.thry-stencil-weights {
    min-height: 18px;
}

.thry-stencil-weights .thry-stencil-decimal, .thry-stencil-weights .thry-stencil-label {
    color: #999999;
    font-size: var(--thry-type-caption);
}

.thry-stencil-derived .thry-stencil-bit:disabled {
    opacity: 1;
    background-color: #363636;
    border-color: #363636;
    color: #a0a0a0;
}

.thry-stencil-derived .thry-stencil-bit.thry-stencil-bit-set:disabled {
    color: #202020;
    background-color: var(--thry-stencil-lit-color);
    opacity: 0.65;
}

.thry-stencil-operation {
    min-width: 0;
    margin: var(--thry-space-2) 0;
    min-height: var(--thry-button-height);
}

.thry-stencil-operation > .unity-base-field__label {
    width: 120px;
    min-width: 80px;
    margin: 0;
    font-size: var(--thry-type-small);
}

.thry-stencil-explanation {
    white-space: normal;
    font-size: var(--thry-type-small);
    color: #b2b2b2;
    margin: var(--thry-space-2) 0;
    padding: var(--thry-space-2) 0;
}

.thry-stencil-outcome {
    white-space: normal;
    font-size: var(--thry-type-small);
    -unity-font-style: bold;
    color: #dedede;
    margin: var(--thry-space-2) 0 0;
    padding: var(--thry-space-6) 0 var(--thry-space-2);
    border-top-width: var(--thry-border-width);
    border-top-color: #474747;
}

.thry-stencil-narrow .thry-stencil-byte-row {
    flex-direction: column;
    align-items: stretch;
}

.thry-stencil-narrow .thry-stencil-label {
    width: auto;
    min-height: 18px;
}

.thry-stencil-narrow .thry-stencil-values {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 100%;
}

.thry-stencil-narrow .thry-stencil-operation {
    flex-direction: column;
    align-items: stretch;
}

.thry-stencil-narrow .thry-stencil-operation > .unity-base-field__label {
    width: auto;
    margin-bottom: var(--thry-space-2);
}

.thry-light .thry-stencil-view {
    background-color: #c9c9c9;
}

.thry-light .thry-stencil-bit {
    background-color: #e4e4e4;
    border-color: #e4e4e4;
    color: #555555;
}

.thry-light .thry-stencil-bit.thry-stencil-bit-set {
    background-color: var(--thry-stencil-lit-color);
    border-color: var(--thry-stencil-lit-color);
    color: #202020;
}

.thry-light .thry-stencil-outcome, .thry-light .thry-stencil-explanation {
    color: #333333;
}

.thry-light .thry-stencil-bit:hover, .thry-light .thry-stencil-bit:focus {
    border-color: var(--thry-accent-color);
}

.thry-light .thry-stencil-weights .thry-stencil-bit, .thry-light .thry-stencil-weights .thry-stencil-decimal, .thry-light .thry-stencil-weights .thry-stencil-label {
    color: #5b5b5b;
}

.thry-light .thry-stencil-derived .thry-stencil-bit:disabled {
    background-color: #d2d2d2;
    border-color: #d2d2d2;
    color: #6e6e6e;
}

.thry-light .thry-stencil-derived .thry-stencil-bit.thry-stencil-bit-set:disabled {
    background-color: var(--thry-stencil-lit-color);
    color: #252525;
}

.thry-light .thry-stencil-outcome {
    border-top-color: #b0b0b0;
}

/* Monokai role colors; keep decimal fields compact and mask symbols unfilled. */
.thry-stencil-buffer {
    --thry-stencil-lit-color: var(--thry-monokai-yellow);
}

.thry-stencil-reference {
    --thry-stencil-lit-color: var(--thry-monokai-cyan);
}

.thry-stencil-output {
    --thry-stencil-lit-color: var(--thry-monokai-green);
}

.thry-stencil-view .thry-stencil-mask .thry-stencil-bit,
.thry-light .thry-stencil-view .thry-stencil-mask .thry-stencil-bit {
    background-color: transparent;
    border-color: transparent;
    color: #999999;
    font-size: 15px;
}

.thry-stencil-view .thry-stencil-mask .thry-stencil-bit-blocked {
    color: var(--thry-monokai-orange);
}

.thry-light .thry-stencil-view .thry-stencil-mask .thry-stencil-bit-blocked {
    color: #a85c00;
}

.thry-stencil-view .thry-stencil-mask .thry-stencil-bit-set {
    color: var(--thry-channel-r-color);
}

.thry-light .thry-stencil-view .thry-stencil-mask .thry-stencil-bit-set {
    color: var(--thry-channel-r-color);
}

.thry-stencil-view .thry-stencil-mask .thry-stencil-bit:hover,
.thry-stencil-view .thry-stencil-mask .thry-stencil-bit:focus,
.thry-light .thry-stencil-view .thry-stencil-mask .thry-stencil-bit:hover,
.thry-light .thry-stencil-view .thry-stencil-mask .thry-stencil-bit:focus {
    border-color: var(--thry-accent-color);
}

/* Stencil comparison branches remain aligned with their operation cards. */
.thry-stencil-flow {
    position: relative;
    height: 62px;
    margin-top: 4px;
}

.thry-stencil-route {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--thry-muted-color);
}

.thry-stencil-line {
    position: absolute;
    background-color: var(--thry-muted-color);
}

.thry-stencil-flow-caption {
    position: absolute;
    margin-left: 7px;
    font-size: 10px;
}

.thry-stencil-flow-arrow {
    position: absolute;
    top: 49px;
    margin-left: -5px;
    padding: 0;
    font-size: 12px;
}

.thry-stencil-flow-cards {
    flex-direction: row;
}

.thry-stencil-flow-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 5px;
    margin: 0 2px;
    border-width: 1px;
    border-color: var(--thry-border-color);
    border-radius: 3px;
}

.thry-stencil-flow-title {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
}

.thry-stencil-flow-card .thry-stencil-operation {
    flex-direction: column;
    align-items: stretch;
}

.thry-stencil-flow-card .thry-stencil-operation > .unity-base-field__label {
    width: auto;
    min-width: 0;
    font-size: 10px;
    margin-bottom: 3px;
}

.thry-stencil-flow-card .unity-base-field__input {
    min-width: 0;
}

.thry-stencil-route-active {
    color: var(--thry-channel-g-color);
    border-color: var(--thry-channel-g-color);
}

.thry-stencil-route-active .thry-stencil-line {
    background-color: var(--thry-channel-g-color);
}

.thry-stencil-fail-route.thry-stencil-route-active {
    color: var(--thry-channel-r-color);
    border-color: var(--thry-channel-r-color);
}

.thry-stencil-fail-route.thry-stencil-route-active .thry-stencil-line {
    background-color: var(--thry-channel-r-color);
}

/* ===== ThryTextureStudio ===== */
/* A pannable channel-packing board with fixed node positions. */
.thry-studio-graph-window {
    --thry-studio-canvas: #1e1e1e;
    padding: 0;
    background-color: var(--thry-studio-canvas);
}

.thry-studio-graph-window.thry-light {
    --thry-studio-canvas: #999999;
}

.thry-studio-graph-window .unity-base-field__label {
    color: var(--thry-caption-color);
}

.thry-studio-graph-window .unity-base-field:disabled > .unity-base-field__label {
    color: var(--thry-muted-color);
}

.thry-studio-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 48px;
    flex-wrap: wrap;
    padding: var(--thry-space-8) var(--thry-space-16);
    background-color: var(--thry-chrome-background);
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: var(--thry-border-color);
}

.thry-studio-heading {
    flex-grow: 1;
    min-width: 120px;
    font-size: var(--thry-type-heading);
    -unity-font-style: bold;
    color: var(--thry-value-color);
}

.thry-studio-toolbar #studio-open-texture {
    width: 210px;
    margin: 0 14px 0 0;
}

.thry-studio-toolbar #studio-open-texture > .unity-base-field__label {
    min-width: 34px;
    width: 34px;
}

.thry-studio-toolbar #save-texture {
    height: var(--thry-window-control-height);
    margin: 0;
    padding: 0 var(--thry-space-16);
    border-radius: var(--thry-radius-control);
    -unity-font-style: bold;
}

.thry-studio-graph-help {
    flex-shrink: 0;
    min-height: 32px;
    white-space: normal;
    margin: 0;
    padding: 0 var(--thry-space-18);
    -unity-text-align: middle-left;
    font-size: var(--thry-type-small);
    color: var(--thry-muted-color);
    background-color: var(--thry-panel-background);
}

.thry-studio-graph-workspace {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.thry-studio-graph {
    background-color: var(--thry-studio-canvas);
}

.thry-studio-graph GridBackground {
    --grid-background-color: var(--thry-studio-canvas);
    --line-color: var(--thry-row-alternate);
    --thick-line-color: var(--thry-row-hover);
    --spacing: 20;
    --thick-lines: 5;
}

.thry-studio-graph .thry-studio-node {
    min-width: 0;
    min-height: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

.thry-studio-graph .thry-studio-node > #selection-border {
    border-width: 0;
    margin: 0;
    padding: 0;
}

.thry-studio-graph .thry-studio-node > #node-border {
    flex-grow: 1;
    min-height: 0;
    border-width: var(--thry-border-width);
    border-color: var(--thry-border-color);
    border-radius: var(--thry-radius-card);
    background-color: var(--thry-panel-background);
    overflow: hidden;
}

.thry-studio-graph .thry-studio-node #title {
    height: 25px;
    min-height: 25px;
    padding: 0 var(--thry-space-10);
    background-color: var(--thry-section-background);
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: var(--thry-section-background);
    border-color: var(--thry-section-background);
}

.thry-studio-graph .thry-studio-node #title-label {
    font-size: var(--thry-type-small);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    color: var(--thry-caption-color);
}

.thry-studio-graph .thry-studio-node #title-button-container {
    display: none;
}

.thry-studio-graph .thry-studio-node #contents {
    flex-grow: 1;
    min-height: 0;
    background-color: transparent;
}

.thry-studio-graph .thry-studio-node #extension {
    flex-grow: 1;
    min-height: 0;
    padding: 0;
    background-color: transparent;
}

.thry-studio-graph .thry-studio-node #collapsible-area {
    flex-grow: 1;
    min-height: 0;
}

.thry-studio-graph .thry-studio-node #divider {
    display: none;
}

.thry-studio-node-field {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin: var(--thry-space-5) var(--thry-space-8) var(--thry-space-3);
    height: var(--thry-control-height);
}

.thry-studio-node-field > .unity-base-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.thry-studio-node-field > Button {
    width: 22px;
    min-width: 22px;
    height: var(--thry-control-height);
    margin: 0 0 0 var(--thry-space-4);
    padding: 0;
    border-width: 0;
    font-size: var(--thry-type-heading);
}

.thry-studio-source-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    padding: 0 0 var(--thry-space-7) var(--thry-space-8);
}

.thry-studio-source-frame {
    position: absolute;
    min-width: 0;
    background-color: var(--thry-input-background);
    border-radius: var(--thry-radius-compact);
    overflow: hidden;
}

.thry-studio-source-frame > Label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: var(--thry-type-small);
    color: var(--thry-muted-color);
}

.thry-studio-graph .thry-studio-node #output, .thry-studio-graph .thry-studio-node #input {
    padding: 0;
    margin: 0;
    min-width: 48px;
    width: 48px;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
    background-color: transparent;
}

.thry-studio-graph .thry-studio-node Port {
    height: 19px;
    min-height: 14px;
    flex-shrink: 1;
    padding: 0 var(--thry-space-7);
    margin: 0;
}

.thry-studio-graph .thry-studio-node Port #type {
    font-size: var(--thry-type-small);
    -unity-font-style: bold;
    color: var(--thry-value-color);
}

.thry-studio-graph .thry-studio-node Port #connector {
    width: 12px;
    height: 12px;
    border-width: var(--thry-border-width-strong);
    border-radius: var(--thry-radius-card);
}

.thry-studio-graph .thry-studio-node Port #connector,
.thry-studio-graph .thry-studio-node Port #cap {
    background-color: var(--thry-panel-background);
}

/* GraphView writes a dark inline cap fill. Light pins use clean colored rings. */
.thry-light .thry-studio-graph .thry-studio-node Port #cap {
    opacity: 0;
}

.thry-studio-graph-window .unity-object-field__selector {
    background-color: transparent;
    -unity-background-image-tint-color: var(--thry-value-color);
}

.thry-studio-graph-window .unity-object-field__selector:hover {
    background-color: var(--thry-hover-color);
}

.thry-studio-graph Port.thry-studio-channel-r {
    --port-color: var(--thry-channel-r-color);
}

.thry-studio-graph Port.thry-studio-channel-g {
    --port-color: var(--thry-channel-g-color);
}

.thry-studio-graph Port.thry-studio-channel-b {
    --port-color: var(--thry-channel-b-color);
}

.thry-studio-graph Port.thry-studio-channel-a {
    --port-color: var(--thry-channel-a-color);
}

.thry-studio-graph Port.thry-studio-channel-max {
    --port-color: var(--thry-muted-color);
}

.thry-studio-graph .thry-studio-node Port:hover {
    background-color: var(--thry-hover-color);
    border-radius: var(--thry-radius-compact);
}

.thry-studio-graph .thry-studio-output-node > #node-border {
    border-color: var(--thry-border-color);
}

.thry-studio-graph .thry-studio-output-node #title {
    background-color: var(--thry-section-background);
}

.thry-studio-output-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin: var(--thry-space-10) var(--thry-space-12) var(--thry-space-10) 0;
}

.thry-studio-graph .thry-studio-output-node Port {
    height: 40px;
    min-height: 40px;
}

.thry-studio-result-image {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    background-color: var(--thry-input-background);
    border-radius: var(--thry-radius-compact);
}

.thry-studio-output-node #extension > .unity-base-popup-field {
    margin: 0 var(--thry-space-12) var(--thry-space-12);
    flex-shrink: 0;
}

.thry-studio-output-node #extension > .unity-base-popup-field > .unity-base-field__label {
    width: 54px;
    min-width: 54px;
}

.thry-studio-graph-status {
    height: var(--thry-toolbar-height);
    flex-shrink: 0;
    margin: 0;
    padding: 0 var(--thry-space-18);
    -unity-text-align: middle-left;
    font-size: var(--thry-type-small);
    color: var(--thry-muted-color);
    border-top-width: var(--thry-border-width);
    border-top-color: var(--thry-border-color);
    background-color: var(--thry-panel-background);
}

.thry-studio-settings-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
    padding: var(--thry-space-8);
    border-top-width: var(--thry-border-width);
    border-top-color: var(--thry-border-color);
}

.thry-studio-settings-header {
    flex-direction: row;
    height: var(--thry-toolbar-height);
    flex-shrink: 0;
    align-items: center;
    margin-bottom: var(--thry-space-6);
}

.thry-studio-settings-header > Label {
    flex-grow: 1;
    -unity-font-style: bold;
    margin-left: var(--thry-space-4);
}

.thry-studio-settings-panel > ScrollView {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}

.thry-studio-settings-panel .thry-studio-section {
    margin-bottom: var(--thry-space-6);
}

.thry-studio-settings-panel .thry-studio-route {
    padding-bottom: var(--thry-space-6);
    margin-bottom: var(--thry-space-6);
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: var(--thry-border-color);
}

.thry-studio-graph .thry-studio-source-missing > #node-border {
    border-color: #c29a5e;
}

.thry-studio-graph .thry-studio-output-node #collapsible-area, .thry-studio-graph .thry-studio-output-node #extension {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

.thry-studio-graph .thry-studio-node #input, .thry-studio-graph .thry-studio-node #output {
    flex-basis: auto;
}

.thry-studio-graph .thry-studio-node #top {
    background-color: transparent;
}

.thry-studio-result-image {
    flex-basis: 0;
}

.thry-studio-graph .edge {
    --edge-width: 3;
}

.thry-studio-graph .thry-studio-node Port #connector {
    min-width: 12px;
    flex-shrink: 0;
    margin: 0 var(--thry-space-3);
}

.thry-studio-graph .thry-studio-node Port #type {
    min-width: 12px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.thry-studio-settings-panel .unity-base-field > .unity-base-field__label {
    min-width: 90px;
    width: 90px;
    max-width: 90px;
    white-space: normal;
}

.thry-studio-settings-panel .unity-base-compound-field__field > .unity-base-field__label {
    min-width: 12px;
    width: 12px;
    max-width: 12px;
}

.thry-studio-settings-panel .unity-base-field .unity-base-field > .unity-base-field__label {
    min-width: 12px;
    width: 12px;
    max-width: 12px;
}

.thry-studio-graph .thry-studio-source-node #contents {
    flex-basis: 0;
    flex-shrink: 1;
}

/* Channel letters must not inherit the settings panel's full-width field labels. */
.thry-studio-settings-panel .thry-studio-export-channels > .unity-toggle {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
}

.thry-studio-settings-panel .thry-studio-export-channels > .unity-toggle > .unity-base-field__label {
    min-width: 12px;
    width: 12px;
    max-width: 12px;
    margin-right: var(--thry-space-4);
    flex-grow: 0;
}

.thry-studio-settings-panel .thry-studio-export-channels > .unity-toggle > .unity-base-field__input {
    flex-grow: 0;
}

/* Presentation previously set inline in C#. Dynamic geometry stays in code. */
.thry-settings-search {
    margin-top: var(--thry-space-8);
    margin-bottom: var(--thry-space-8);
}

.thry-cross-editor {
    padding-left: var(--thry-space-12);
    padding-right: var(--thry-space-12);
}

.thry-texture-slice {
    width: 48px;
    min-width: 32px;
    flex-shrink: 0;
    height: 18px;
    margin-top: 0;
    margin-bottom: 0;
}

.thry-texture-face {
    width: 38px;
    min-width: 38px;
    height: 18px;
    margin-top: 0;
    margin-bottom: 0;
}

.thry-vector-length-number {
    width: 54px;
    flex-shrink: 0;
    margin-left: var(--thry-space-6);
}

.thry-ramp {
    height: var(--thry-ramp-height);
    /* Bind inherited theme variables locally for CustomStyleResolvedEvent. */
    --ramp-stroke-width: var(--thry-ramp-stroke-width);
    --ramp-handle-radius: var(--thry-ramp-handle-radius);
    --ramp-line-color: var(--thry-ramp-line-color);
    --ramp-handle-color: var(--thry-ramp-handle-color);
}

.thry-filter-pending {
    min-height: var(--thry-control-height);
}

.thry-search .unity-search-field-base__search-button {
    color: rgb(188.7, 188.7, 188.7);
}

/* Dropdowns share the flat button treatment. Text, number, object, and search
   fields retain their outlines. Matching fills preserve existing geometry. */
.thry-inspector .unity-base-popup-field > .unity-base-popup-field__input {
    border-color: var(--thry-field-background);
}

.thry-inspector .thry-type-picker .unity-base-field__input {
    border-color: #484848;
}

.thry-inspector.thry-light .thry-type-picker .unity-base-field__input {
    border-color: var(--thry-surface-color);
}

.thry-inspector .thry-status-filter > .unity-base-field__input {
    border-color: #444444;
}

.thry-inspector.thry-light .thry-status-filter > .unity-base-field__input {
    border-color: #dddddd;
}

.thry-inspector .thry-rendering-mode .unity-base-popup-field__input {
    border-color: #505050;
}

.thry-inspector .thry-rendering-mode .unity-base-popup-field__input:hover {
    border-color: #5a5a5a;
}

.thry-inspector.thry-light .thry-rendering-mode .unity-base-popup-field__input {
    border-color: var(--thry-surface-color);
}

.thry-inspector.thry-light .thry-rendering-mode .unity-base-popup-field__input:hover {
    border-color: #eeeeee;
}

.thry-inspector .thry-material-controls .unity-disabled .unity-base-popup-field__input {
    border-color: #323232;
}

.thry-inspector.thry-light .thry-material-controls .unity-disabled .unity-base-popup-field__input {
    border-color: #b9b9b9;
}

/* Both Unity's input focus and retained menus' field focus remain visible,
   including when the rendering-mode dropdown is hovered in either skin. */
.thry-inspector .unity-base-popup-field > .unity-base-popup-field__input:focus,
.thry-inspector .unity-base-popup-field:focus > .unity-base-popup-field__input,
.thry-inspector.thry-light .unity-base-popup-field > .unity-base-popup-field__input:focus,
.thry-inspector.thry-light .unity-base-popup-field:focus > .unity-base-popup-field__input {
    border-color: var(--thry-focus-color);
}

/* ===== Studio visual direction =====
   Surface hierarchy, shapes, and interaction states. Control heights, type sizes,
   label columns, and hit targets continue to use the established metrics. */
.thry-inspector, .thry-dropdown-menu {
    --thry-chrome-background: #484848;
    --thry-row-alternate: rgba(255, 255, 255, .025);
    --thry-row-hover: rgba(255, 255, 255, .045);
    --thry-track-color: #5e5e5e;
    --thry-thumb-color: #999999;
    --thry-action-background: #4c4c4c;
    --thry-action-hover-background: #575757;
    --thry-disabled-background: #323232;
    --thry-disabled-border: #434343;
}

.thry-inspector.thry-light, .thry-dropdown-menu.thry-light {
    --thry-chrome-background: var(--thry-surface-color);
    --thry-action-background: #a0a0a0;
    --thry-action-hover-background: #ababab;
    --thry-row-alternate: rgba(0, 0, 0, .025);
    --thry-section-background: #bebebe;
    --thry-input-background: #dddddd;
    --thry-caption-color: #292929;
    --thry-muted-color: #606060;
    --thry-value-color: #292929;
    --thry-row-hover: rgba(0, 0, 0, .045);
    --thry-track-color: #999999;
    --thry-thumb-color: #999999;
    --thry-disabled-background: #c4c4c4;
    --thry-disabled-border: #b5b5b5;
}

/* A single quiet tool well and a joined search/filter strip. */
.thry-inspector.thry-active {
    color: var(--thry-value-color);
}

.thry-inspector .thry-title {
    color: var(--thry-value-color);
}

.thry-inspector .thry-version {
    color: var(--thry-muted-color);
    background-color: transparent;
    border-radius: var(--thry-radius-round);
    border-width: 1px;
    border-color: var(--thry-border-color);
    padding-top: 1px;
    padding-bottom: 1px;
}

.thry-inspector .thry-tools {
    background-color: transparent;
}

.thry-inspector .thry-tools > .thry-icon-button {
    --thry-button-background: transparent;
    --thry-button-hover-background: transparent;
    --thry-button-pressed-background: transparent;
    --thry-button-disabled-background: transparent;
    color: var(--thry-muted-color);
    border-radius: var(--thry-radius-button);
    align-items: center;
    justify-content: center;
    margin: 0;
}

.thry-inspector .thry-tools > .thry-icon-button.thry-selected {
    border-color: var(--thry-focus-color);
}

.thry-inspector .thry-tools > .thry-icon-button:hover {
    color: var(--thry-value-color);
}

.thry-inspector .thry-tools > .thry-icon-button:focus {
    color: var(--thry-accent-color);
}

.thry-inspector .thry-tools > .thry-collapse-tool,
.thry-inspector .thry-tools > .thry-collapse-tool:hover {
    color: var(--thry-monokai-green);
}

.thry-inspector .thry-tools > .thry-language-tool,
.thry-inspector .thry-tools > .thry-language-tool:hover {
    color: var(--thry-monokai-orange);
}

.thry-inspector.thry-light .thry-tools > .thry-collapse-tool,
.thry-inspector.thry-light .thry-tools > .thry-collapse-tool:hover {
    color: var(--thry-monokai-green);
}

.thry-inspector.thry-light .thry-tools > .thry-language-tool,
.thry-inspector.thry-light .thry-tools > .thry-language-tool:hover {
    color: var(--thry-monokai-orange);
}

.thry-inspector .thry-search {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.thry-inspector .thry-search-filters {
    margin-left: 0;
    background-color: var(--thry-chrome-background);
    border-top-right-radius: var(--thry-radius-panel);
    border-bottom-right-radius: var(--thry-radius-panel);
}

.thry-inspector .thry-search .unity-search-field-base__search-button {
    color: var(--thry-muted-color);
}

.thry-inspector .thry-search-placeholder {
    color: var(--thry-muted-color);
}

.thry-inspector .thry-type-picker .unity-base-field__input,
.thry-inspector .thry-status-filter > .unity-base-field__input,
.thry-inspector.thry-light .thry-type-picker .unity-base-field__input,
.thry-inspector.thry-light .thry-status-filter > .unity-base-field__input {
    background-color: var(--thry-chrome-background);
    border-color: var(--thry-chrome-background);
    border-radius: 0;
}

.thry-inspector .thry-type-picker .unity-base-popup-field__text,
.thry-inspector .thry-status-filter .unity-base-popup-field__text {
    color: var(--thry-caption-color);
}

.thry-inspector .thry-saved-filters {
    color: var(--thry-muted-color);
    border-radius: var(--thry-radius-button);
}

.thry-inspector .thry-saved-filters:hover {
    color: var(--thry-accent-color);
}

.thry-inspector.thry-compact .thry-search {
    border-radius: var(--thry-radius-panel);
}

.thry-inspector.thry-compact .thry-search-filters {
    border-radius: var(--thry-radius-panel);
    overflow: hidden;
}

/* Primary action and secondary actions remain in their familiar positions. */
.thry-inspector .thry-lock-button,
.thry-inspector.thry-light .thry-lock-button {
    -unity-font-style: bold;
}

.thry-inspector .thry-rendering-mode .unity-base-popup-field__input,
.thry-inspector.thry-light .thry-rendering-mode .unity-base-popup-field__input {
    color: var(--thry-action-text-color);
}

/* Open sections form a continuous surface.
   Nested groups use standalone header bars with borderless contents. */
.thry-inspector .thry-root-section {
    border-radius: var(--thry-radius-header);
    background-color: var(--thry-panel-background);
}

.thry-inspector .thry-root-section > .thry-section-header {
    background-color: var(--thry-root-section-background);
    border-color: var(--thry-root-section-background);
}

.thry-inspector .thry-root-section > .thry-section-header .thry-section-title {
    -unity-font-style: bold;
    color: var(--thry-root-section-text-color);
}

/* Keep content indentation without a surrounding frame or guide line. */
.thry-inspector .thry-root-section > .thry-section-content,
.thry-inspector .thry-subsection-panel > .thry-section-content,
.thry-inspector .thry-positioning-panel > .thry-section-content {
    margin: var(--thry-space-4) 0;
    border-width: 0;
    padding: 0 0 0 9px;
}

.thry-inspector .thry-root-section > .thry-section-content {
    padding-top: var(--thry-space-3);
}

.thry-inspector .thry-positioning-panel > .thry-section-content {
    padding: var(--thry-space-1) 0 var(--thry-space-1) var(--thry-space-6);
}

.thry-inspector .thry-subsection-panel,
.thry-inspector .thry-positioning-panel {
    background-color: transparent;
}

.thry-inspector .thry-subsection-panel > .thry-section-header,
.thry-inspector .thry-positioning-panel > .thry-section-header {
    background-color: var(--thry-subsection-background);
    border-color: var(--thry-subsection-background);
}

.thry-inspector .thry-section-title {
    color: var(--thry-caption-color);
}

/* Fade the whole locked header while preserving its navigation and control behavior. */
.thry-inspector .thry-material-locked .thry-section-header {
    opacity: 0.5;
}

.thry-inspector .thry-material-locked .unity-disabled .thry-section-header {
    opacity: 1;
}

.thry-inspector .thry-section-header .thry-header-action {
    opacity: .8;
}

.thry-inspector .thry-section-header .thry-header-action:hover,
.thry-inspector .thry-section-header .thry-header-action:focus,
.thry-inspector .thry-section-header .thry-linked {
    opacity: 1;
}

.thry-inspector .thry-header-icon {
    --unity-image-tint-color: var(--thry-muted-color);
}

.thry-inspector .thry-header-action:hover .thry-header-icon,
.thry-inspector .thry-fold-arrow:hover .thry-header-icon {
    --unity-image-tint-color: var(--thry-value-color);
}

.thry-inspector .thry-linked .thry-header-icon,
.thry-inspector .thry-header-action:focus .thry-header-icon {
    --unity-image-tint-color: var(--thry-accent-color);
}

/* Header hover highlights the surface; only a directly hovered icon brightens.
   Keyboard focus and linked-state indicators keep their explicit feedback. */
.thry-inspector .thry-section-header:hover,
.thry-inspector .thry-subsection-panel > .thry-section-header:hover,
.thry-inspector .thry-positioning-panel > .thry-section-header:hover {
    background-color: var(--thry-subsection-hover-background);
    border-color: var(--thry-subsection-hover-background);
}

.thry-inspector .thry-root-section > .thry-section-header:hover {
    background-color: var(--thry-root-section-hover-background);
    border-color: var(--thry-root-section-hover-background);
}

.thry-inspector .thry-header-action,
.thry-inspector .thry-fold-arrow {
    --thry-button-hover-background: transparent;
}

/* Editable wells and distinct button-like choice controls share the same metrics. */
.thry-inspector .thry-property-row.thry-row-alt {
    background-color: var(--thry-row-alternate);
}

.thry-inspector .thry-property-row:hover {
    background-color: var(--thry-row-hover);
}

.thry-inspector .thry-material-controls .unity-base-text-field__input,
.thry-inspector .thry-material-controls .unity-object-field__input,
.thry-inspector.thry-window .unity-base-text-field__input,
.thry-inspector.thry-window .unity-object-field__input {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
    color: var(--thry-value-color);
    border-radius: var(--thry-radius-control);
}

.thry-inspector .thry-material-controls .unity-base-popup-field__input,
.thry-inspector.thry-window .unity-base-popup-field__input {
    background-color: var(--thry-dropdown-background);
    border-color: var(--thry-dropdown-background);
}

.thry-inspector .thry-material-controls .unity-base-popup-field__text,
.thry-inspector.thry-window .unity-base-popup-field__text {
    color: var(--thry-value-color);
}

.thry-inspector .thry-material-controls .unity-base-popup-field__input:hover,
.thry-inspector.thry-window .unity-base-popup-field__input:hover {
    background-color: var(--thry-dropdown-hover-background);
    border-color: var(--thry-dropdown-hover-background);
}

.thry-inspector .thry-material-controls .unity-disabled .unity-base-text-field__input,
.thry-inspector .thry-material-controls .unity-disabled .unity-object-field__input {
    background-color: var(--thry-disabled-background);
    border-color: var(--thry-disabled-border);
}

.thry-inspector .thry-material-controls .unity-disabled .unity-base-popup-field__input,
.thry-inspector.thry-light .thry-material-controls .unity-disabled .unity-base-popup-field__input {
    background-color: var(--thry-disabled-background);
    border-color: var(--thry-disabled-background);
}

.thry-inspector .thry-component > .unity-base-field__label {
    color: var(--thry-muted-color);
}

.thry-inspector .thry-texture-expanded > .thry-texture-details {
    border-left-color: var(--thry-border-color);
}

.thry-inspector .thry-texture-summary .thry-texture-preview {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
}

.thry-inspector .thry-texture-description,
.thry-inspector .thry-asset-size,
.thry-inspector .thry-muted {
    color: var(--thry-muted-color);
}

/* Slim instrument-like slider handles; the native drag and keyboard behavior stays intact. */
.thry-inspector .unity-slider.unity-base-slider--horizontal .unity-base-slider__tracker {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    margin: -1px 0 0;
    border-width: 0;
    border-radius: 1px;
    background-color: var(--thry-track-color);
}

.thry-inspector .unity-slider.unity-base-slider--horizontal .unity-base-slider__dragger {
    position: absolute;
    top: 50%;
    left: 0;
    width: 6px;
    height: 10px;
    margin: -5px 0 0;
    border-width: 0;
    border-radius: 2px;
    background-color: var(--thry-thumb-color);
}

.thry-inspector .unity-slider.unity-base-slider--horizontal .unity-base-slider__dragger-border {
    display: none;
}

.thry-inspector .unity-slider:hover .unity-base-slider__dragger,
.thry-inspector .unity-slider:focus .unity-base-slider__dragger {
    background-color: var(--thry-value-color);
}

.thry-inspector .thry-material-controls .unity-toggle__checkmark {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
}

.thry-inspector .thry-material-controls .unity-toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
    -unity-background-image-tint-color: var(--thry-value-color);
}

/* Header toggles share the tintable property tick. Unity's native checkmark carries
   its own colors, so the light-skin value tint would darken it almost to black. */
.thry-inspector .thry-header-reference > .unity-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: none;
    -unity-background-scale-mode: scale-to-fit;
}

.thry-inspector .thry-header-reference > .unity-toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: url("ThryToolbar/property-checkmark.png");
}

/* Property checkboxes use the same surface as text fields in every toggle state.
   Explicit property ancestry overrides Unity's native checkbox state rules. */
.thry-inspector .thry-material-controls .thry-property-value > .unity-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--thry-field-background);
    border-color: var(--thry-control-border-color);
}

.thry-inspector .thry-material-controls .unity-disabled .thry-property-value > .unity-toggle > .unity-toggle__input > .unity-toggle__checkmark,
.thry-inspector .thry-material-controls .thry-property-value > .unity-toggle.unity-disabled > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--thry-disabled-background);
    border-color: var(--thry-disabled-border);
}

.thry-inspector .thry-material-controls .unity-foldout__toggle > .unity-toggle__input > .unity-toggle__checkmark,
.thry-inspector .thry-material-controls .unity-foldout__toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
    -unity-background-image-tint-color: var(--thry-muted-color);
}

.thry-inspector .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--thry-value-color);
}

/* The same surface language extends to Pathing, menus, and companion windows. */
.thry-inspector.thry-window .unity-foldout__toggle {
    background-color: var(--thry-subsection-background);
    border-color: var(--thry-subsection-background);
    color: var(--thry-caption-color);
}

/* Studio settings are compact disclosures inside a node, not inspector category bars. */
.thry-inspector.thry-studio-graph-window .thry-studio-section > .unity-foldout__toggle {
    min-height: var(--thry-button-height);
    margin: 0;
    padding: 0 var(--thry-space-2);
    background-color: transparent;
    border-color: transparent;
    border-radius: var(--thry-radius-control);
    color: var(--thry-caption-color);
    font-size: var(--thry-type-body-small);
    -unity-font-style: normal;
}

.thry-inspector.thry-studio-graph-window .thry-studio-section > .unity-foldout__toggle:hover {
    background-color: var(--thry-hover-color);
    border-color: var(--thry-hover-color);
}

.thry-inspector.thry-studio-graph-window .thry-studio-section > .unity-foldout__toggle .unity-toggle__text {
    color: var(--thry-caption-color);
}

.thry-inspector.thry-studio-graph-window .thry-studio-section > .unity-foldout__toggle:focus {
    background-color: var(--thry-hover-color);
    border-color: var(--thry-muted-color);
}

.thry-inspector.thry-studio-graph-window .thry-studio-section > .unity-foldout__toggle .unity-toggle__checkmark,
.thry-inspector.thry-studio-graph-window .thry-studio-section > .unity-foldout__toggle .unity-foldout__checkmark {
    background-color: transparent;
    border-width: 0;
    -unity-background-image-tint-color: var(--thry-muted-color);
}

.thry-inspector.thry-studio-graph-window .thry-studio-section > .unity-foldout__content {
    margin-left: var(--thry-space-8);
    padding-top: var(--thry-space-2);
    padding-bottom: var(--thry-space-6);
}

/* Give the output settings their own quiet hierarchy within the graph node. */
.thry-studio-settings-panel {
    padding: var(--thry-space-8) var(--thry-space-12);
}

.thry-studio-settings-header {
    margin-bottom: var(--thry-space-2);
}

.thry-studio-settings-header > Label {
    margin-left: 0;
    font-size: 13px;
    color: var(--thry-value-color);
}

.thry-studio-settings-panel #studio-settings-scroll > .thry-studio-section {
    margin: 0;
    padding: var(--thry-space-4) 0;
    border-bottom-width: var(--thry-border-width);
    border-bottom-color: var(--thry-border-color);
}

.thry-inspector.thry-studio-graph-window .thry-studio-settings-panel #studio-settings-scroll > .thry-studio-section > .unity-foldout__toggle {
    min-height: 28px;
    -unity-font-style: bold;
    color: var(--thry-value-color);
}

.thry-studio-settings-panel .unity-base-field {
    min-height: 24px;
    margin-top: var(--thry-space-2);
    margin-bottom: var(--thry-space-2);
}

.thry-studio-settings-panel .unity-base-field .unity-base-field {
    min-height: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.thry-studio-settings-panel .unity-base-field > .unity-base-field__label {
    -unity-text-align: middle-left;
}

.thry-studio-settings-panel .thry-studio-hint {
    white-space: normal;
    font-size: var(--thry-type-small);
    color: var(--thry-muted-color);
    background-color: var(--thry-input-background);
    border-radius: var(--thry-radius-control);
    padding: var(--thry-space-8);
    margin: var(--thry-space-8) 0 var(--thry-space-4);
}

.thry-studio-settings-panel #studio-file-options {
    margin-top: var(--thry-space-4);
    margin-bottom: 0;
}

.thry-inspector .pathing-grid-heading {
    background-color: var(--thry-subsection-background);
}

.thry-inspector .pathing-cell.pathing-selected {
    background-color: var(--thry-row-hover);
}

.thry-inspector .pathing-grid-heading .pathing-cell.pathing-selected {
    background-color: var(--thry-selection-background);
}

/* Pathing is a comparison table: keep its column structure stronger than the
   surrounding borderless headers and buttons, even when a path is off. */
.thry-inspector .thry-pathing .pathing-grid {
    border-width: var(--thry-border-width);
    border-color: var(--thry-pathing-column-divider);
    border-radius: var(--thry-radius-control);
}

.thry-inspector .thry-pathing .pathing-cell {
    border-left-width: var(--thry-border-width);
    border-left-color: var(--thry-pathing-column-divider);
}

.thry-inspector .thry-pathing .pathing-channel-1,
.thry-inspector .thry-pathing .pathing-channel-3 {
    background-color: var(--thry-pathing-column-alternate);
}

.thry-inspector .thry-pathing .pathing-cell.pathing-selected {
    background-color: var(--thry-row-hover);
}

.thry-inspector .thry-pathing .pathing-grid-heading {
    border-radius: 0;
}

.thry-inspector .thry-pathing .pathing-grid-heading .pathing-cell.pathing-selected {
    background-color: var(--thry-selection-background);
}

.thry-inspector .thry-studio-preview,
.thry-inspector .thry-studio-route,
.thry-inspector .thry-studio-source,
.thry-inspector .thry-stencil-view {
    background-color: var(--thry-panel-background);
}

.thry-dropdown-menu .thry-menu-card {
    background-color: var(--thry-panel-background);
    border-color: var(--thry-border-color);
    border-radius: var(--thry-radius-card);
}

.thry-dropdown-menu .thry-menu-item Label {
    color: var(--thry-value-color);
}

.thry-dropdown-menu .thry-menu-selected {
    background-color: var(--thry-selection-background);
}

.thry-dropdown-menu .thry-menu-separator {
    background-color: var(--thry-border-color);
}

.thry-inspector .thry-footer-credit {
    color: var(--thry-muted-color);
}

/* Rendering mode is a toolbar action and uses the same surface as Presets.
   This follows the generic field rules so a popup's input fill cannot win. */
.thry-inspector .thry-rendering-mode .unity-base-popup-field__input,
.thry-inspector.thry-light .thry-rendering-mode .unity-base-popup-field__input {
    background-color: var(--thry-action-background);
    border-color: var(--thry-action-background);
    margin: 0;
    height: var(--thry-section-height);
    min-height: var(--thry-section-height);
    max-height: var(--thry-section-height);
}

.thry-inspector .thry-rendering-mode .unity-base-popup-field__input:hover,
.thry-inspector.thry-light .thry-rendering-mode .unity-base-popup-field__input:hover {
    background-color: var(--thry-action-hover-background);
    border-color: var(--thry-action-hover-background);
}

/* Action layouts and colored icons; Button interaction styling is shared above. */
.thry-inspector .thry-positioning-button:enabled > Label {
    color: var(--thry-action-text-color);
}

.thry-inspector .thry-positioning-button:disabled > Label {
    color: var(--thry-muted-color);
}

.thry-bake-color-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.thry-bake-color-button > Label {
    margin: 0;
}

.thry-bake-color-icon {
    width: 14px;
    height: 14px;
    min-width: 14px;
    flex-shrink: 0;
    margin-right: var(--thry-space-6);
    color: var(--thry-monokai-yellow);
}

/* A deeper ochre keeps the painted icon at 5:1 on light action buttons. */
.thry-light .thry-bake-color-icon {
    color: #6b5c10;
}

.thry-inspector .thry-positioning-status {
    color: var(--thry-muted-color);
}

.thry-inspector .thry-positioning-tools {
    border-bottom-color: var(--thry-border-color);
}

/* Focus is the last layer so hover and skin-specific fills never hide it. */
.thry-inspector .thry-search.thry-search-focused,
.thry-inspector.thry-light .thry-search.thry-search-focused,
.thry-inspector .unity-base-text-field__input:focus,
.thry-inspector.thry-light .unity-base-text-field__input:focus,
.thry-inspector .unity-base-field:focus > .unity-base-field__input,
.thry-inspector .unity-base-popup-field > .unity-base-popup-field__input:focus,
.thry-inspector .unity-base-popup-field:focus > .unity-base-popup-field__input,
.thry-inspector.thry-light .unity-base-popup-field > .unity-base-popup-field__input:focus,
.thry-inspector.thry-light .unity-base-popup-field:focus > .unity-base-popup-field__input {
    border-color: var(--thry-focus-color);
}

.thry-inspector .thry-search .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--thry-value-color);
}

/* Appearance sliders: -20 to 20, with zero retaining the palette above.
   Foregrounds adapt at the
   brighter dark-skin and darker light-skin ends to preserve text contrast. */
/* Dark skin: dark surfaces. */
.thry-inspector.thry-dark.thry-gray-dark-n10, .thry-dropdown-menu.thry-dark.thry-gray-dark-n10 {
    --thry-background-color: #101010;
    --thry-panel-background: #0b0b0b;
    --thry-input-background: #010101;
    --thry-disabled-background: #0a0a0a;
}

.thry-inspector.thry-dark.thry-gray-dark-n9, .thry-dropdown-menu.thry-dark.thry-gray-dark-n9 {
    --thry-background-color: #141414;
    --thry-panel-background: #0f0f0f;
    --thry-input-background: #050505;
    --thry-disabled-background: #0e0e0e;
}

.thry-inspector.thry-dark.thry-gray-dark-n8, .thry-dropdown-menu.thry-dark.thry-gray-dark-n8 {
    --thry-background-color: #181818;
    --thry-panel-background: #131313;
    --thry-input-background: #090909;
    --thry-disabled-background: #121212;
}

.thry-inspector.thry-dark.thry-gray-dark-n7, .thry-dropdown-menu.thry-dark.thry-gray-dark-n7 {
    --thry-background-color: #1c1c1c;
    --thry-panel-background: #171717;
    --thry-input-background: #0d0d0d;
    --thry-disabled-background: #161616;
}

.thry-inspector.thry-dark.thry-gray-dark-n6, .thry-dropdown-menu.thry-dark.thry-gray-dark-n6 {
    --thry-background-color: #202020;
    --thry-panel-background: #1b1b1b;
    --thry-input-background: #111111;
    --thry-disabled-background: #1a1a1a;
}

.thry-inspector.thry-dark.thry-gray-dark-n5, .thry-dropdown-menu.thry-dark.thry-gray-dark-n5 {
    --thry-background-color: #242424;
    --thry-panel-background: #1f1f1f;
    --thry-input-background: #151515;
    --thry-disabled-background: #1e1e1e;
}

.thry-inspector.thry-dark.thry-gray-dark-n4, .thry-dropdown-menu.thry-dark.thry-gray-dark-n4 {
    --thry-background-color: #282828;
    --thry-panel-background: #232323;
    --thry-input-background: #191919;
    --thry-disabled-background: #222222;
}

.thry-inspector.thry-dark.thry-gray-dark-n3, .thry-dropdown-menu.thry-dark.thry-gray-dark-n3 {
    --thry-background-color: #2c2c2c;
    --thry-panel-background: #272727;
    --thry-input-background: #1d1d1d;
    --thry-disabled-background: #262626;
}

.thry-inspector.thry-dark.thry-gray-dark-n2, .thry-dropdown-menu.thry-dark.thry-gray-dark-n2 {
    --thry-background-color: #303030;
    --thry-panel-background: #2b2b2b;
    --thry-input-background: #212121;
    --thry-disabled-background: #2a2a2a;
}

.thry-inspector.thry-dark.thry-gray-dark-n1, .thry-dropdown-menu.thry-dark.thry-gray-dark-n1 {
    --thry-background-color: #343434;
    --thry-panel-background: #2f2f2f;
    --thry-input-background: #252525;
    --thry-disabled-background: #2e2e2e;
}

.thry-inspector.thry-dark.thry-gray-dark-p1, .thry-dropdown-menu.thry-dark.thry-gray-dark-p1 {
    --thry-background-color: #393939;
    --thry-panel-background: #343434;
    --thry-input-background: #2a2a2a;
    --thry-disabled-background: #333333;
}

.thry-inspector.thry-dark.thry-gray-dark-p2, .thry-dropdown-menu.thry-dark.thry-gray-dark-p2 {
    --thry-background-color: #3a3a3a;
    --thry-panel-background: #353535;
    --thry-input-background: #2b2b2b;
    --thry-disabled-background: #343434;
}

.thry-inspector.thry-dark.thry-gray-dark-p3, .thry-dropdown-menu.thry-dark.thry-gray-dark-p3 {
    --thry-background-color: #3a3a3a;
    --thry-panel-background: #353535;
    --thry-input-background: #2b2b2b;
    --thry-disabled-background: #343434;
}

.thry-inspector.thry-dark.thry-gray-dark-p4, .thry-dropdown-menu.thry-dark.thry-gray-dark-p4 {
    --thry-background-color: #3b3b3b;
    --thry-panel-background: #363636;
    --thry-input-background: #2c2c2c;
    --thry-disabled-background: #353535;
}

.thry-inspector.thry-dark.thry-gray-dark-p5, .thry-dropdown-menu.thry-dark.thry-gray-dark-p5 {
    --thry-background-color: #3c3c3c;
    --thry-panel-background: #373737;
    --thry-input-background: #2d2d2d;
    --thry-disabled-background: #363636;
}

.thry-inspector.thry-dark.thry-gray-dark-p6, .thry-dropdown-menu.thry-dark.thry-gray-dark-p6 {
    --thry-background-color: #3d3d3d;
    --thry-panel-background: #383838;
    --thry-input-background: #2e2e2e;
    --thry-disabled-background: #373737;
}

.thry-inspector.thry-dark.thry-gray-dark-p7, .thry-dropdown-menu.thry-dark.thry-gray-dark-p7 {
    --thry-background-color: #3e3e3e;
    --thry-panel-background: #393939;
    --thry-input-background: #2f2f2f;
    --thry-disabled-background: #383838;
}

.thry-inspector.thry-dark.thry-gray-dark-p8, .thry-dropdown-menu.thry-dark.thry-gray-dark-p8 {
    --thry-background-color: #3e3e3e;
    --thry-panel-background: #393939;
    --thry-input-background: #2f2f2f;
    --thry-disabled-background: #383838;
}

.thry-inspector.thry-dark.thry-gray-dark-p9, .thry-dropdown-menu.thry-dark.thry-gray-dark-p9 {
    --thry-background-color: #3f3f3f;
    --thry-panel-background: #3a3a3a;
    --thry-input-background: #303030;
    --thry-disabled-background: #393939;
}

.thry-inspector.thry-dark.thry-gray-dark-p10, .thry-dropdown-menu.thry-dark.thry-gray-dark-p10 {
    --thry-background-color: #404040;
    --thry-panel-background: #3b3b3b;
    --thry-input-background: #313131;
    --thry-disabled-background: #3a3a3a;
}

/* Dark skin: medium surfaces. */
.thry-inspector.thry-dark.thry-gray-medium-n10, .thry-dropdown-menu.thry-dark.thry-gray-medium-n10 {
    --thry-surface-color: #3d3d3d;
    --thry-hover-color: #444444;
    --thry-subsection-background: #414141;
    --thry-subsection-hover-background: #4c4c4c;
    --thry-section-background: #454545;
    --thry-chrome-background: #404040;
    --thry-action-background: #444444;
    --thry-action-hover-background: #4f4f4f;
    --thry-button-pressed-background: #393939;
}

.thry-inspector.thry-dark.thry-gray-medium-n9, .thry-dropdown-menu.thry-dark.thry-gray-medium-n9 {
    --thry-surface-color: #3e3e3e;
    --thry-hover-color: #454545;
    --thry-subsection-background: #424242;
    --thry-subsection-hover-background: #4d4d4d;
    --thry-section-background: #464646;
    --thry-chrome-background: #414141;
    --thry-action-background: #454545;
    --thry-action-hover-background: #505050;
    --thry-button-pressed-background: #3a3a3a;
}

.thry-inspector.thry-dark.thry-gray-medium-n8, .thry-dropdown-menu.thry-dark.thry-gray-medium-n8 {
    --thry-surface-color: #3f3f3f;
    --thry-hover-color: #464646;
    --thry-subsection-background: #434343;
    --thry-subsection-hover-background: #4e4e4e;
    --thry-section-background: #474747;
    --thry-chrome-background: #424242;
    --thry-action-background: #464646;
    --thry-action-hover-background: #515151;
    --thry-button-pressed-background: #3b3b3b;
}

.thry-inspector.thry-dark.thry-gray-medium-n7, .thry-dropdown-menu.thry-dark.thry-gray-medium-n7 {
    --thry-surface-color: #3f3f3f;
