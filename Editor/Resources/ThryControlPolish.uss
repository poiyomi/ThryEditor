/* Compact property feedback; hierarchy arrows remain quiet icon controls. */
.thry-positioning-panel { margin: 3px 0 7px; border-width: 1px; border-color: #515151; border-radius: 5px; background-color: #333333; overflow: hidden; }
.thry-positioning-panel > .thry-section-header { border-radius: 0; background-color: #444444; }
.thry-positioning-panel > .thry-section-content { padding: 5px; }
.thry-positioning-tools { margin: 0 0 5px; padding-bottom: 4px; border-bottom-width: 1px; border-bottom-color: #494949; }
.thry-positioning-actions { flex-direction: row; }
.thry-positioning-actions > .thry-positioning-button { flex-grow: 1; flex-basis: 0; min-width: 0; height: 25px; margin: 0; padding: 0 5px; flex-direction: row; align-items: center; justify-content: center; background-color: #444444; border-width: 1px; border-color: #5a5a5a; border-radius: 4px; color: #c4c4c4; }
.thry-positioning-actions > .thry-positioning-secondary { margin-left: 3px; }
.thry-positioning-button > Label { margin: 0; font-size: 12px; color: #c4c4c4; }
.thry-positioning-icon { width: 16px; height: 16px; min-width: 16px; margin-right: 6px; color: #a6e22e; }
.thry-positioning-actions > .thry-positioning-button:hover { background-color: #515151; border-color: #747474; }
.thry-positioning-actions > .thry-positioning-button:focus { border-color: #7aadd6; }
.thry-positioning-actions > .thry-positioning-active { background-color: #435563; border-color: #7aadd6; }
.thry-positioning-status { margin: 4px 1px 0; white-space: normal; font-size: 11px; color: #aaaaaa; }
.thry-light .thry-positioning-panel { background-color: #c9c9c9; border-color: #a3a3a3; }
.thry-light .thry-positioning-panel > .thry-section-header { background-color: #b9b9b9; }
.thry-light .thry-positioning-tools { border-bottom-color: #acacac; }
.thry-light .thry-positioning-actions > .thry-positioning-button { background-color: #dedede; border-color: #a3a3a3; color: #333333; }
.thry-light .thry-positioning-button > Label { color: #333333; }
.thry-light .thry-positioning-icon { color: #638f14; }
.thry-light .thry-positioning-status { color: #555555; }
.thry-light .thry-positioning-actions > .thry-positioning-button:hover { background-color: #eeeeee; }
.thry-light .thry-positioning-actions > .thry-positioning-active { background-color: #bfd1df; border-color: #3b78a8; }
.thry-tools > .thry-collapse-tool { align-items: center; justify-content: center; color: #a6e22e; }
.thry-tools > .thry-language-tool { align-items: center; justify-content: center; color: #fd971f; }
.thry-light .thry-tools > .thry-collapse-tool { color: #638f14; }
.thry-light .thry-tools > .thry-language-tool { color: #b86509; }
.thry-inspector .thry-property-row.thry-row-alt { background-color: rgba(255, 255, 255, 0.025); border-radius: 3px; }
.thry-light .thry-property-row.thry-row-alt { background-color: rgba(0, 0, 0, 0.025); }
.thry-inspector .thry-property-row:hover { background-color: rgba(255, 255, 255, 0.045); border-radius: 3px; }
.thry-light .thry-property-row:hover { background-color: rgba(0, 0, 0, 0.045); }
.thry-material-controls .unity-base-text-field__input:focus,
.thry-material-controls .unity-base-popup-field__input:focus,
.thry-window .unity-base-text-field__input:focus,
.thry-window .unity-base-popup-field__input:focus { border-color: var(--thry-focus-color); }
.thry-light .unity-base-text-field__input:focus,
.thry-light .unity-base-popup-field__input:focus { border-color: #326f9c; }

/* Axis captions occupy equal slots. Custom component captions keep their width. */
.thry-components { align-items: center; flex-wrap: nowrap; }
.thry-components > .thry-component { align-items: center; }
.thry-components > .thry-component-spaced { margin-left: 4px; }
.thry-components > .thry-component-axis > .unity-base-field__label { width: 12px; min-width: 12px; max-width: 12px; flex-shrink: 0; margin-right: 2px; -unity-text-align: middle-center; }
.thry-component > .unity-base-text-field__input { min-width: 0; padding-left: 4px; padding-right: 3px; }

/* The texture row and its revealed controls form one continuous disclosure. */
.thry-texture-property.thry-texture-expanded { background-color: #333333; border-radius: 4px; }
.thry-texture-expanded > .thry-texture-heading-row { margin-bottom: 0; }
.thry-texture-expanded > .thry-texture-details { background-color: transparent; margin: 0 0 3px 7px; padding: 2px 3px 4px 6px; border-radius: 0; border-left-width: 1px; border-left-color: #555555; }
.thry-texture-details > .thry-texture-card { margin: 0; }
.thry-texture-card .thry-texture-name { -unity-font-style: normal; }
.thry-light .thry-texture-property.thry-texture-expanded { background-color: #c9c9c9; }
.thry-light .thry-texture-expanded > .thry-texture-details { background-color: transparent; border-left-color: #a0a0a0; }

/* Assigned cards use a fixed-height summary; only horizontal preview area grows. */
.thry-texture-card .thry-texture-summary { padding-bottom: 0; margin-bottom: 2px; }
.thry-texture-card-with-inputs .thry-texture-summary { border-bottom-width: 0; }
.thry-texture-card-assigned .thry-texture-summary { height: 68px; min-height: 68px; max-height: 68px; }
.thry-texture-card .thry-texture-preview { align-self: flex-start; }
.thry-texture-card .thry-texture-info { min-width: 0; overflow: hidden; }
.thry-texture-card .thry-texture-name,
.thry-texture-card .thry-texture-description { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.thry-texture-card .thry-texture-description { margin: 0 2px; font-size: 11px; }
.thry-texture-card .thry-texture-channels { margin-top: 2px; flex-wrap: nowrap; min-width: 0; }
.thry-texture-card .thry-texture-channels Button { flex-shrink: 1; min-width: 18px; margin-right: 2px; }
.thry-texture-card .thry-texture-channels #texture-channel-RGB { min-width: 28px; }
.thry-texture-card-compact .thry-texture-channels Button { width: 22px; height: 20px; min-height: 20px; }
.thry-texture-card-compact .thry-texture-channels #texture-channel-RGB { width: 30px; }
.thry-texture-card .thry-texture-channels .thry-texture-gradient-action { width: 62px; min-width: 58px; flex-shrink: 0; margin-left: 4px; padding: 0 4px; font-size: 11px; }

/* Nested disabled containers must not multiply opacity until controls disappear. */
.thry-material-controls .unity-disabled { opacity: 1; }
.thry-material-controls .unity-disabled .thry-property-label,
.thry-material-controls .unity-disabled .thry-texture-caption,
.thry-material-controls .unity-disabled .unity-base-field__label { color: #969696; }
.thry-material-controls .unity-disabled .unity-base-text-field__input,
.thry-material-controls .unity-disabled .unity-base-popup-field__input,
.thry-material-controls .unity-disabled .unity-object-field__input { color: #969696; background-color: #323232; border-color: #434343; }
.thry-light .thry-material-controls .unity-disabled .thry-property-label,
.thry-light .thry-material-controls .unity-disabled .thry-texture-caption,
.thry-light .thry-material-controls .unity-disabled .unity-base-field__label { color: #696969; }
.thry-light .thry-material-controls .unity-disabled .unity-base-text-field__input,
.thry-light .thry-material-controls .unity-disabled .unity-base-popup-field__input,
.thry-light .thry-material-controls .unity-disabled .unity-object-field__input { color: #696969; background-color: #b9b9b9; border-color: #a6a6a6; }
